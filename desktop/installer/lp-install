def read_password(a):
    """The password, from stdin - never argv, which /proc shows to all."""
    if not getattr(a, "password_stdin", False):
        return None
    pw = sys.stdin.readline()
    return pw[:-1] if pw.endswith("\n") else pw


def add_answers(p):
    """The options install and configure share."""
    p.add_argument("--lang", default=None,
                   help="en_US.UTF-8 (the default) or ko_KR.UTF-8")
    p.add_argument("--user", help="the login name of the person's account")
    p.add_argument("--fullname", default="", help="their name as they write it")
    p.add_argument("--password-stdin", action="store_true",
                   help="read the account's password from the first line of stdin")
    p.add_argument("--hostname", help="the computer's name")
    p.add_argument("--timezone", help="e.g. Asia/Seoul")
    p.add_argument("--keyboard", choices=sorted(KEYBOARDS))


def main():
    global PROGRESS
    ap = argparse.ArgumentParser(prog="lp-install",
                                 description="Install the running LP system onto a disk.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("list", help="the disks, and which could take LP")
    a.add_argument("--json", action="store_true")
    a = sub.add_parser("check", help="firmware settings that stop an install")
    a.add_argument("--json", action="store_true")
    a = sub.add_parser("install", help="install LP on a disk, into a partition,"
                                       " or into a disk's free space")
    where = a.add_mutually_exclusive_group(required=True)
    where.add_argument("--disk", help="erase this whole disk for LP")
    where.add_argument("--partition",
                       help="erase this partition of a GPT disk for LP; the other"
                            " partitions stay as they are")
    where.add_argument("--free-space", metavar="DISK",
                       help="make a new partition for LP in this GPT disk's largest"
                            " unallocated region")
    a.add_argument("--size", type=int, metavar="MiB",
                   help="with --free-space: LP-ROOT's size (default: all of the region)")
    a.add_argument("--no-recovery", action="store_true",
                   help="with --free-space: no LP-RECOVERY, even when there is room")
    a.add_argument("--dry-run", action="store_true",
                   help="say what would be erased, made and kept, and write nothing")
    a.add_argument("--json", action="store_true", help="with --dry-run: as JSON")
    a.add_argument("--yes", action="store_true", help="do not ask; for scripts")
    a.add_argument("--progress", action="store_true",
                   help="machine-readable progress lines (for lp-installer)")
    a.add_argument("--no-boot-entry", action="store_true",
                   help="leave the firmware's boot list alone")
    add_answers(a)
    a = sub.add_parser("configure",
                       help="apply account, language, time zone, name to a system"
                            " (the first-boot setup's backend)")
    a.add_argument("--root", default="/")
    a.add_argument("--finish", action="store_true",
                   help="the first-boot setup is over: remove /etc/lp/firstboot")
    add_answers(a)
    args = ap.parse_args()

    if args.cmd == "list":
        disks = list_disks()
        if args.json:
            print(json.dumps(disks, ensure_ascii=False))
        else:
            for d in disks:
                print("%-10s %-9s %-6s %-32s %s" % (
                    d["path"], d["size_text"], d["transport"] or "-", d["model"][:32],
                    "ok" if d["usable"] else "no: " + d["reason"]))
                for p in d["parts"]:
                    label = p["label"] or p["partlabel"]
                    print("  %-14s %-9s %-6s %-22s %s" % (
                        p["dev"], p["size_text"], p["fstype"] or "-",
                        ('"%s"' % label if label else p["type_name"] or "-")[:22],
                        "ok" if p["usable"] else "no: " + p["reason"]))
                for r in d["free"]:
                    print("  %-14s %-9s %-6s %-22s %s" % (
                        "free", r["size_text"], "-",
                        "+".join(["LP-ESP"] * r["new_esp"] + ["LP-RECOVERY"] * r["recovery"]
                                 + ["LP-ROOT %s" % r["root_size_text"]]),
                        "ok" if r["usable"] else "no: " + r["reason"]))
        return 0
    if args.cmd == "check":
        info, _ = checks()
        if args.json:
            print(json.dumps(info, ensure_ascii=False))
        else:
            print("UEFI: %s  Secure Boot: %s  Intel RAID: %s  needs: %s" % (
                "yes" if info["efi"] else "no", "on" if info["secure_boot"] else "off",
                "yes" if info["intel_raid"] else "no", human(info["needed"])))
            for p in info["problems"]:
                print("problem:", p["en"])
        return 1 if info["problems"] else 0

    if os.geteuid() != 0:
        print("lp-install: this needs root (sudo lp-install ...)", file=sys.stderr)
        return 1
    PROGRESS = getattr(args, "progress", False)
    try:
        password = read_password(args)
        if args.cmd == "configure":
            root = os.path.realpath(args.root)
            validate(root, args, password)
            done = configure(root, args, hash_password(password) if args.user else None)
            if args.finish:
                try:
                    os.unlink(os.path.join(root, FIRSTBOOT))
                except FileNotFoundError:
                    pass
                fd = os.open(os.path.join(root, "etc/lp"), os.O_RDONLY | os.O_DIRECTORY)
                os.fsync(fd)
                os.close(fd)
            elif os.path.exists(os.path.join(root, FIRSTBOOT)):
                lang = args.lang or next((ln[5:] for ln in read(os.path.join(
                    root, FIRSTBOOT)).splitlines() if ln.startswith("lang=")), "")
                write_firstboot(root, lang, done)
            say("DONE", "configured=%s" % ",".join(sorted(done)))
            return 0
        if args.lang is None:
            args.lang = "en_US.UTF-8"
        if args.no_recovery and not args.free_space:
            raise Refused("bad-option", "--no-recovery goes with --free-space")
        if args.size is not None and not args.free_space:
            raise Refused("bad-size", "--size goes with --free-space")
        if args.size is not None and args.size <= 0:
            raise Refused("bad-size", "--size is a number of MiB")
        install(args, password)
    except Refused as e:
        say("ERROR", e.key, str(e)) if PROGRESS else print("lp-install: %s" % e, file=sys.stderr)
        return 2
    except (RuntimeError, OSError) as e:
        say("ERROR", "failed", str(e)) if PROGRESS else print("lp-install: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
