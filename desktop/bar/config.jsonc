// The top bar, laid out the way shell-design-spec.md §2-1 lays it out.
//
//   [작업공간 레일] [검색]  ·····빈 공간·····  [트레이] │ [모드] [한] [시계] [하드웨어]
//
// The centre is empty on purpose and stays empty. The spec gives two
// reasons and both are still true: an empty middle sends the eye to the
// two ends so the bar goes quiet, and it is the space notifications and
// the media readout will need. Putting the clock there - which is what
// every other desktop does - spends it.
{
  "layer": "top",
  "position": "top",
  // 30 이 아니라 34.
  //
  // 명세는 30 이라고 적었고 오래 그렇게 두었는데, 오른쪽 알약이
  // 들어오면서 waybar 가 매 부팅마다 "Requested height: 30 is less
  // than the minimum height: 33 required by the modules" 를 남겼다.
  // 그림은 맞게 나오지만, 매번 나오는 경고는 나중에 진짜 문제가
  // 생겼을 때 그것을 가린다. 4px 은 눈에 띄지 않고 로그는 조용해진다.
  "height": 34,
  "spacing": 0,
  // 작업표시줄이 왼쪽으로 왔다.
  //
  // 오른쪽 상태 묶음 안에 아이콘만 두었을 때는 열린 창이 있는지조차
  // 눈에 띄지 않았다 - 시계와 배터리 사이에 낀 16px 짜리 그림이었다.
  // 창을 최소화하면 그것으로 창을 잃는 데스크탑에서, 다시 부르는
  // 유일한 길이 그렇게 작으면 없는 것과 같다.
  //
  // 왼쪽에 두면 이름까지 넣을 수 있고, 늘어나도 비어 있는 가운데로
  // 자라므로 오른쪽 상태 묶음을 밀지 않는다. 2-1 이 가운데를 비워
  // 두라고 한 것은 그 자리를 무엇으로도 채우지 말라는 뜻이 아니라
  // 시선을 양 끝에 두라는 뜻이고, 열린 창 목록은 왼쪽 끝에 붙어
  // 자라는 것이라 그 규칙을 깨지 않는다.
  "modules-left":   ["sway/workspaces", "custom/search", "wlr/taskbar"],
  "modules-center": [],
  "modules-right":  ["tray", "custom/mode", "custom/ime",
                     "clock",
                     "network", "backlight", "pulseaudio", "battery",
                     "custom/quick"],

  // 상태 묶음 하나가 곧 퀵메뉴 버튼이다.
  //
  // 처음에는 옆에 ⌄ 를 따로 두었다. 그건 이 화면에만 있는 규칙이라,
  // 우분투나 맥을 쓰던 사람은 그 버튼이 있는 줄도 모르고 아이콘을
  // 누른다. 그리고 그게 맞다 - 신호와 소리와 배터리를 한 덩어리로
  // 묶어 놓고 그 덩어리를 누르면 열리는 것이 사람들이 이미 아는
  // 방식이다. 그래서 ⌄ 를 빼고, 묶음 자체에 배경을 주어 눌리는
  // 것처럼 보이게 했다. 어느 아이콘을 눌러도 같은 패널이 열린다.
  // 오른쪽 끝의 다섯은 하나의 알약으로 보인다. 묶는 것은 waybar 의
  // group 이 아니라 CSS 다.
  //
  // group/status 를 먼저 써 봤고, waybar 0.9.17 은 그것을 세로로
  // 쌓았다: "Requested height: 30 is less than the minimum height: 46"
  // 이 두 칸이 위아래로 붙은 높이다. 그 판의 group 은 서랍
  // (drawer)을 위한 것이라 가로 바에서도 세로로 눕는다.
  //
  // 그래서 각 칸에 같은 배경을 주고 양 끝만 둥글린다. 가운데 칸들은
  // 하드웨어에 따라 사라지지만(가상 머신에는 배터리도 백라이트도
  // 없다) 양 끝인 network 와 ⌄ 는 늘 있으므로 알약은 늘 알약이다.
  "custom/quick": {
    "format": "⌄",
    "tooltip": false,
    "on-click": "lp-quick"
  },

  // The rail. A fixed 32px whatever the count, which is the whole point
  // of the design: dots grow sideways with the number of workspaces and
  // push everything to their right along with them.
  "sway/workspaces": {
    "format": "{index}",
    "disable-scroll": false,
    "all-outputs": true
  },

  // Ctrl+Space opens it, as the shortcut list already promises. The bar
  // entry is here so the entry point is visible - the one thing Windows
  // 8 got wrong that Spotlight and Activities get right.
  "custom/search": {
    "exec": "lp-bar-label search",
    "interval": "once",
    "tooltip": false,
    "on-click": "fuzzel"
  },

  // Amber, and only amber, and only when something is limited. The spec
  // reserves that colour for a constraint; a bar that is amber for
  // decoration has nowhere left to go when something really is limited.
  //
  // 비어 있을 때는 아무것도 그리지 않는다 - 2-4 는 켜져 있을 때만
  // 보이라고 했고, 꺼진 상태를 회색 아이콘으로 그려 두면 그 자리가
  // 늘 차 있어서 정작 켜졌을 때 눈에 띄지 않는다.
  "custom/mode": {
    "exec": "lp-bar-label mode",
    "interval": 2,
    "tooltip": false
  },

  // 한 or A. One glyph however many input sources exist - see
  // design/gui/topbar-input.html for why the width is fixed.
  // 지금 걸려 있는 배열을 묻는다. 고정된 글자를 찍어 두면 배열을
  // 바꿔도 그대로라서, 표시가 아니라 장식이 된다.
  "custom/ime": {
    "exec": "lp-bar-label ime",
    "interval": 2,
    "tooltip": false,
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },

  "clock": {
    "format": "{:%a %H:%M}",
    // 눌렀을 때 나오는 긴 꼴. 숫자 날짜라 어느 언어에서도 읽힌다.
    "format-alt": "{:%Y-%m-%d %a %H:%M}",
    "tooltip": false
  },
  // ── 오른쪽 상태 묶음 ──
  //
  // 눌렀을 때 나오는 것은 셋 다 같은 퀵메뉴다(2-1: 하나의 정보
  // 덩어리). 하지만 열지 않고도 답이 나와야 한다 - 신호가 센지,
  // 소리가 얼마인지, 배터리가 몇 퍼센트인지는 패널을 여는 이유가
  // 아니라 패널을 열지 않아도 되게 하는 정보다.
  //
  // 처음에는 셋 다 고정된 글리프 하나였다. ◈ 는 연결되어 있다는
  // 뜻이었지 신호가 어떻다는 뜻이 아니었고, ◑ 는 볼륨이 얼마든
  // ◑ 였다. 그건 표시가 아니라 자리 표시자다.

  // 신호 세기를 네 칸으로. essid 는 넣지 않는다 - 이름이 길면
  // 오른쪽 전체가 밀려서 시계와 배터리가 자리를 지키지 못한다.
  // 이름은 툴팁과 퀵메뉴에 있다.
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "⌁",
    "format-linked": "⌁",
    "format-disconnected": "⚠",
    "format-icons": ["▁", "▃", "▅", "▇"],
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ifname}  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    // waybar 의 설정은 JSON 이라 언어를 물어볼 수 없다. 이 기계의
    // 기본 언어는 영어이므로 영어로 적는다 - 영어로 쓰는 사람에게
    // 한국어 툴팁이 뜨는 것이 그 반대보다 흔하고, 더 이상하다.
    "tooltip-format-disconnected": "Not connected",
    "on-click": "lp-quick"
  },

  // 숫자를 같이 찍는다. 아이콘만으로는 40% 와 60% 를 구별할 수 없고,
  // 볼륨은 그 차이를 알고 싶어서 보는 것이다.
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "🔇",
    "format-icons": { "default": ["○", "◔", "◑", "●"] },
    "scroll-step": 5,
    "on-click": "lp-quick",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc}  {volume}%"
  },

  // 밝기. 백라이트가 없는 기계에서는 waybar 가 이 모듈을 통째로
  // 감추므로, 없는 조절 손잡이가 바에 남지 않는다.
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["·", "∴", "☀"],
    "scroll-step": 5,
    "on-click": "lp-quick",
    "tooltip-format": "Brightness {percent}%"
  },

  // 퍼센트를 적는다. 배터리 아이콘만 있는 바에서 "얼마나 남았지" 를
  // 알려면 결국 눌러야 하고, 그러면 바에 있는 의미가 없다.
  // 배터리가 없는 기계에서는 waybar 가 감춘다.
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "format-plugged": "⌁ {capacity}%",
    "format-icons": ["▁", "▃", "▅", "▇", "█"],
    "states": { "warning": 20, "critical": 10 },
    "on-click": "lp-quick",
    "tooltip-format": "{capacity}%  ·  {time}"
  },
  "tray": { "spacing": 8, "icon-size": 14 },

  // 열려 있는 창들. 명세서 2-3 의 '백그라운드 앱' 자리이고, 이것이
  // 없으면 창을 최소화한 순간 다시 부를 방법이 사라진다 - 떠 있는
  // 창만 있는 데스크탑에서는 그것이 곧 창을 잃는 일이다.
  //
  // 아이콘과 제목. 아이콘만 두었을 때는 같은 앱의 창 두 개를 구별할
  // 수 없었고, 작업표시줄이 답해야 하는 질문이 바로 그것이다.
  // 왼쪽에 있으므로 길어져도 가운데 빈 공간으로 자라고, max-length
  // 가 상한을 잡아서 오른쪽 상태 묶음까지 밀지는 않는다.
  "wlr/taskbar": {
    "format": "{icon} {title}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    // 누르면 그 창으로 간다. 이미 그 창에 있으면 내려간다 - 같은
    // 버튼이 부르고 치우는 것이 작업표시줄이 하는 일이다.
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["fuzzel", "org.lpzero.QuickMenu"],
    // 제목이 길어도 바를 밀지 않게. 열 몇 개가 열려도 오른쪽은
    // 그대로 있어야 한다.
    "max-length": 60,
    "markup": false
  }
}
