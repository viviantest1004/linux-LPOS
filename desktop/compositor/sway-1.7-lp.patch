+// ── LP: maximize ───────────────────────────────────────────────────────
+//
+// LP floats every window, and stock sway ignores a window's request to be
+// maximized, so the maximize button on every title bar did nothing. A
+// maximized container here is a floating container fitted to its output's
+// usable area - the output minus the layer-shell exclusive zones of the top
+// bar and the dock - and arrange_workspace keeps it fitted when that area
+// changes (the dock gives its room back while a window is maximized).
+
+void container_floating_fit_maximized(struct sway_container *con) {
+	if (!con->maximized || !con->view || !container_is_floating(con) ||
+			con->pending.fullscreen_mode != FULLSCREEN_NONE) {
+		return;
+	}
+	struct sway_workspace *ws = con->pending.workspace;
+	if (!ws || !ws->output) {
+		return;
+	}
+	struct sway_output *output = ws->output;
+	struct wlr_box *area = &output->usable_area;
+	if (area->width <= 0 || area->height <= 0) {
+		return;
+	}
+	con->pending.x = output->lx + area->x;
+	con->pending.y = output->ly + area->y;
+	con->pending.width = area->width;
+	con->pending.height = area->height;
+	node_set_dirty(&con->node);
+}
+
+void container_floating_set_maximized(struct sway_container *con,
+		bool maximized) {
+	if (!con->view) {
+		return;
+	}
+	if (!container_is_floating(con) || con->maximized == maximized) {
+		// Nothing changes, but the client asked and waits for an answer.
+		view_set_maximized(con->view, con->maximized);
+		return;
+	}
+	struct sway_workspace *ws = con->pending.workspace;
+	struct sway_output *output = ws ? ws->output : NULL;
+	if (maximized) {
+		if (!output) {
+			view_set_maximized(con->view, false);
+			return;
+		}
+		con->maximize_restore.x = con->pending.x - output->lx;
+		con->maximize_restore.y = con->pending.y - output->ly;
+		con->maximize_restore.width = con->pending.width;
+		con->maximize_restore.height = con->pending.height;
+		con->maximized = true;
+		container_floating_fit_maximized(con);
+	} else {
+		con->maximized = false;
+		if (output && con->maximize_restore.width > 0 &&
+				con->maximize_restore.height > 0) {
+			con->pending.x = output->lx + con->maximize_restore.x;
+			con->pending.y = output->ly + con->maximize_restore.y;
+			con->pending.width = con->maximize_restore.width;
+			con->pending.height = con->maximize_restore.height;
+		} else if (ws) {
+			container_floating_set_default_size(con);
+			container_floating_move_to_center(con);
+		}
+		node_set_dirty(&con->node);
+	}
+	view_set_maximized(con->view, con->maximized);
+}
+
+void container_floating_forget_maximized(struct sway_container *con) {
+	if (!con->maximized) {
+		return;
+	}
+	con->maximized = false;
+	if (con->view) {
+		view_set_maximized(con->view, false);
+	}
+}
