+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/container.h"
+#include "util.h"
+
+// LP: maximize [enable|disable|toggle]
+//
+// What the maximize button on a window's own title bar does, from a key:
+// the window fills its output's usable area, and the same command puts it
+// back. Only floating windows are maximized this way - every window in
+// LP's session floats - so on a tiled one it does nothing, successfully.
+struct cmd_results *cmd_maximize(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "maximize", EXPECTED_AT_MOST, 1))) {
+		return error;
+	}
+	struct sway_container *con = config->handler_context.container;
+	if (!con || !con->view || !con->pending.workspace ||
+			!container_is_floating(con)) {
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+	bool enable = !con->maximized;
+	if (argc == 1) {
+		enable = parse_boolean(argv[0], con->maximized);
+	}
+	container_floating_set_maximized(con, enable);
+	arrange_workspace(con->pending.workspace);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
