+#include "sway/commands.h"
+#include "sway/tree/container.h"
+#include "sway/tree/root.h"
+
+// LP: minimize
+//
+// What the minimize button on a window's own title bar does, from a key:
+// the window is hidden (in the scratchpad) and comes back from the dock.
+struct cmd_results *cmd_minimize(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "minimize", EXPECTED_EQUAL_TO, 0))) {
+		return error;
+	}
+	struct sway_container *con = config->handler_context.container;
+	if (!con || !con->view || !con->pending.workspace || con->minimized) {
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+	root_minimize_container(con);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
