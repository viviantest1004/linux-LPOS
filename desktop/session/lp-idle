#!/bin/sh
#
# lp-idle - 화면을 언제 끌지.
#
# swayidle 은 시간을 명령줄에서 한 번 받고 다시 읽지 않는다. 그래서
# 설정에서 시간을 바꾸면 그 프로세스를 갈아 끼우는 수밖에 없고, 이
# 스크립트가 하는 일이 그것이다: 돌고 있던 것을 죽이고, 새 값으로
# 다시 띄운다. 설정 앱은 파일을 쓰고 이것을 부르기만 한다.
#
# 값은 초 단위. 0 이면 끄지 않는다.

CONF="$HOME/.config/lp/idle"
SECS=600

if test -r "$CONF" ; then
    SECS="$(cat "$CONF")"
fi

# 돌고 있던 것. 두 개가 같이 살면 화면이 두 번 꺼진다.
OLD="$(pidof swayidle)"
if test -n "$OLD" ; then
    kill $OLD
fi

if test "$SECS" = "0" ; then
    exit 0
fi

# Under wayfire the compositor does this itself, from [idle] dpms_timeout
# in wayfire.ini, which Settings writes along with the file above. swayidle
# would only be a second timer, and swaymsg has no sway to talk to there.
case "${XDG_CURRENT_DESKTOP:-}" in
    *wayfire*|*Wayfire*) exit 0 ;;
esac

# -w: 명령이 끝날 때까지 기다린다. 이것이 없으면 화면을 켜는 명령이
# 끄는 명령보다 먼저 끝나서 꺼진 채로 남는 일이 있다.
exec swayidle -w \
    timeout "$SECS" 'swaymsg "output * dpms off"' \
    resume           'swaymsg "output * dpms on"'
