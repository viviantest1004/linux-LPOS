#!/bin/sh
# 소리를 순서대로 띄우고, 띄운 채로 남는다.
#
# ── 두 가지를 여기서 고쳤다 ──
#
# 1. 순서. sway 의 exec 세 줄로 pipewire, pipewire-pulse, wireplumber 를
#    한꺼번에 시작했더니 wireplumber 가 pipewire 보다 먼저 떠서 붙을
#    데를 찾지 못했다.
#
# 2. 수명. 순서를 고친 뒤에도 소리가 없었다. 로그에는 wireplumber 가
#    시작하고 3초 뒤에 "disconnected from pipewire" 한 줄만 남았는데,
#    그 3초는 이 스크립트가 살아 있던 시간이었다. 셋을 전부 & 로
#    띄우고 스크립트가 끝나면, 그 프로세스 그룹이 정리되면서 셋도
#    같이 사라진다.
#
#    그래서 마지막 하나는 앞에서 돌린다. 스크립트가 wireplumber 만큼
#    오래 살고, 그동안 나머지 둘도 함께 산다. sway 의 exec 는 원래
#    이렇게 오래 사는 명령을 위한 것이다.
#
# 남는 증상이 서로 똑같아서 이 둘을 구별하는 데 시간이 걸렸다:
# 카드가 없을 때도, wireplumber 가 죽었을 때도 화면에는 "소리 장치가
# 없습니다" 라고만 나온다. 아래 진단 두 줄이 그 차이를 콘솔에 남긴다.

# 다시 불렸을 때 (아래의 wireplumber 가 세 번 실패해 lp-shell-start 가
# 이 스크립트를 다시 띄울 때) 이미 떠 있는 pipewire 옆에 하나를 더
# 띄우면, 소켓이 이미 있다며 바로 죽고 pipewire-pulse 도 "주소가 이미
# 사용 중" 으로 죽는다. 떠 있으면 그것을 쓴다.
if pidof pipewire > /dev/null 2>&1 ; then
    echo "[audio] pipewire 가 이미 떠 있습니다"
else
    /usr/bin/pipewire &
fi

i=0
while test $i -lt 100 ; do
    if test -S "$XDG_RUNTIME_DIR/pipewire-0" ; then
        break
    fi
    sleep 0.1
    i=$((i + 1))
done

if test -S "$XDG_RUNTIME_DIR/pipewire-0" ; then
    echo "[audio] pipewire 소켓이 생겼습니다"
else
    echo "[audio] pipewire 가 소켓을 만들지 못했습니다. 소리 없이 갑니다."
    exit 1
fi

if pidof pipewire-pulse > /dev/null 2>&1 ; then
    echo "[audio] pipewire-pulse 가 이미 떠 있습니다"
else
    /usr/bin/pipewire-pulse &
fi

# 카드가 아예 없는 것과, 카드는 있는데 잡지 못한 것을 구별할 수 있게.
echo "[audio] cards: $(cat /proc/asound/cards 2>/dev/null | tr '\n' ' ')"

# wireplumber 를 몇 번 다시 띄워 본다.
#
# 첫 연결이 어쩌다 실패하는 경우라면 두 번째에 붙는다. 계속 실패하는
# 기계라면 세 번이나 스무 번이나 결과가 같으므로 세 번에서 멈춘다 -
# 붙지 못하는 것을 초당 한 번씩 영원히 다시 시도하는 것은 고치는 것이
# 아니라 콘솔을 덮는 것이다.
#
# ── 지금 알려진 것 ──
#
# wireplumber 가 pipewire 에 붙자마자 "disconnected from pipewire" 로
# 끝나던 것은 (QEMU 의 HDA 에서 재현해 확인했다) 블루투스 모니터가
# systemd-logind 를 찾다 실패하면 wireplumber 전체가 그만두기 때문이었다.
# LP 에는 logind 가 없다. /etc/wireplumber/bluetooth.lua.d/
# 80-lp-no-logind.lua 가 그것을 끈다 (session/wireplumber-no-logind.lua).
# 그 뒤로는 첫 번째에 붙고, 카드가 기본 출력 장치가 된다.
tries=0
while test $tries -lt 3 ; do
    /usr/bin/wireplumber
    tries=$((tries + 1))
    echo "[audio] wireplumber 가 끊겼습니다 ($tries/3)"
    sleep 1
done
echo "[audio] wireplumber 가 pipewire 에 붙지 못했습니다."
echo "[audio]   카드는 위의 cards 줄에 있습니다. 소리 장치 없이 갑니다."
