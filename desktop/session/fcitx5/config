# fcitx5 for LP: English and 두벌식 Hangul, switched with the Hangul key
# (Right Alt too, as wayfire's korean:ralt_hangul) or Shift+Space; and
# Super+Space, which is wayfire's binding (lp-input-lang). Settings >
# Keyboard rewrites the trigger keys below when those are changed, and
# can add Ctrl+Space, off at first because it is also every code
# editor's completion key.
[Hotkey]
# Enumerate when press trigger key repeatedly
EnumerateWithTriggerKeys=True
EnumerateSkipFirst=False

[Hotkey/TriggerKeys]
0=Hangul
1=Shift+space

[Behavior]
# Active By Default
ActiveByDefault=False
ShareInputState=All
ShowInputMethodInformation=True
