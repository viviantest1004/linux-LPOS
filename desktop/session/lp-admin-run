#!/usr/bin/python3
"""lp-admin-run PROGRAM [ARGS...] - start a program as root, after the
administrator's password.

Programs that change the machine itself (GParted) start through pkexec,
and pkexec asks for the password through an authentication agent that
has to register for the person's login session - which comes from
systemd-logind. LP has no logind, so every agent died with "No session
for pid" and pkexec answered "No authentication agent found": pressing
GParted did nothing.

This asks here instead, in a small window, and hands the password to
LP's own sudo on its standard input (sudo -S). sudo checks it as it
always does - the person's own password, members of group sudo only,
three tries - and starts the program with what it needs to show its
window on this screen. The password never goes on a command line.
"""
import os
import subprocess
import sys
import tempfile

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib  # noqa: E402

KO = os.environ.get("LANG", "").startswith("ko")


def T(en, ko):
    return ko if KO else en


# What a program started as root needs to draw on this person's screen.
KEEP = ("WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DISPLAY", "GDK_BACKEND", "GTK_THEME",
        "GTK_CSD", "QT_QPA_PLATFORM", "LANG", "LC_MESSAGES", "XDG_DATA_DIRS",
        "XDG_CURRENT_DESKTOP")


def start(prog, password):
    """True when the program is running (or ran) as root, False when the
    password was refused; the message sudo gave in the second case."""
    env = ["%s=%s" % (k, os.environ[k]) for k in KEEP if os.environ.get(k)]
    err = tempfile.TemporaryFile()
    p = subprocess.Popen(["sudo", "-S", "-p", "", "env"] + env + prog,
                         stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                         stderr=err, start_new_session=True)
    p.stdin.write((password + "\n").encode())
    p.stdin.close()
    # A refused password makes sudo give up within a few seconds (it
    # waits two after a wrong one, then finds no second line); a program
    # still running after that was started.
    try:
        rc = p.wait(timeout=8)
    except subprocess.TimeoutExpired:
        return True, ""
    err.seek(0)
    msg = err.read().decode("utf-8", "replace")
    if rc != 0 and ("incorrect password" in msg or "Sorry" in msg or
                    "not in the sudoers" in msg or "may not run sudo" in msg):
        return False, msg.strip().splitlines()[-1] if msg.strip() else ""
    return True, ""


def main():
    prog = sys.argv[1:]
    if not prog:
        print("usage: lp-admin-run PROGRAM [ARGS...]", file=sys.stderr)
        return 2
    name = os.path.basename(prog[0])

    win = Gtk.Window(title=T("Administrator password", "관리자 암호"))
    win.set_default_size(420, -1)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_resizable(False)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    for side in ("top", "bottom", "start", "end"):
        getattr(box, "set_margin_" + side)(20)
    win.add(box)

    title = Gtk.Label(xalign=0)
    title.set_markup("<b>%s</b>" % GLib.markup_escape_text(
        T("%s needs the administrator's password" % name,
          "%s 을(를) 열려면 관리자 암호가 필요합니다" % name)))
    title.set_line_wrap(True)
    box.pack_start(title, False, False, 0)
    note = Gtk.Label(label=T("It changes this computer itself, so it runs as root.",
                             "이 컴퓨터 자체를 바꾸는 프로그램이라 관리자 권한으로 실행됩니다."),
                     xalign=0)
    note.set_line_wrap(True)
    box.pack_start(note, False, False, 0)

    entry = Gtk.Entry()
    entry.set_visibility(False)
    entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
    entry.set_placeholder_text(T("Your password", "내 암호"))
    box.pack_start(entry, False, False, 0)
    status = Gtk.Label(xalign=0)
    box.pack_start(status, False, False, 0)

    buttons = Gtk.Box(spacing=8)
    buttons.set_halign(Gtk.Align.END)
    cancel = Gtk.Button(label=T("Cancel", "취소"))
    ok = Gtk.Button(label=T("Open", "열기"))
    ok.get_style_context().add_class("suggested-action")
    buttons.pack_start(cancel, False, False, 0)
    buttons.pack_start(ok, False, False, 0)
    box.pack_start(buttons, False, False, 0)

    result = {"code": 1}

    def go(*_):
        pw = entry.get_text()
        if not pw:
            return
        ok.set_sensitive(False)
        entry.set_sensitive(False)
        status.set_text(T("Checking…", "확인하는 중…"))
        while Gtk.events_pending():
            Gtk.main_iteration()
        started, why = start(prog, pw)
        if started:
            result["code"] = 0
            Gtk.main_quit()
            return
        entry.set_text("")
        entry.set_sensitive(True)
        ok.set_sensitive(True)
        entry.grab_focus()
        status.set_text(T("That password was not accepted.", "암호가 맞지 않습니다."))

    ok.connect("clicked", go)
    entry.connect("activate", go)
    cancel.connect("clicked", lambda *_: Gtk.main_quit())
    win.connect("destroy", lambda *_: Gtk.main_quit())
    win.show_all()
    entry.grab_focus()
    Gtk.main()
    return result["code"]


if __name__ == "__main__":
    sys.exit(main())
