#!/bin/sh
# lp-shell-start - everything on the screen that is not a window.
#
# Both compositors start exactly this: wayfire from wayfire.ini's
# [autostart], sway from the one `exec` line in sway.config. What is on
# the screen - the wallpaper and desktop icons, the top bar, the dock,
# the on-screen keyboard, notifications - is then the same program under
# either, and only the windows' frames differ.
#
# Each long-lived piece runs under keep(): when it exits it is started
# again, after a second, so a bar that crashes is back before anyone has
# worked out that it went. A piece that dies five times within a minute
# of starting each time is left down (its log says why); restarting a
# program that cannot start only burns the battery.
#
# Nothing is restarted once the compositor has gone: its socket is the
# test. Without that, logging out left five loops trying to reach a
# display that no longer existed.
#
# Logs: $XDG_RUNTIME_DIR/lp-shell/<name>.log, one per piece, kept small.

LOGDIR="${XDG_RUNTIME_DIR:-/tmp}/lp-shell"
mkdir -p "$LOGDIR"

# Applications whose .desktop file says DBusActivatable=true (Text
# Editor, Clocks, Archive Manager...) are started by the session bus, not
# by whoever was clicked, and get the bus's environment - which has no
# WAYLAND_DISPLAY, so they exited at once and a click on them in the dock
# or the app grid did nothing. The session's environment goes to the bus
# first.
dbus-update-activation-environment --all > /dev/null 2>&1 || true

# The compositor's socket. wayfire exports WAYLAND_DISPLAY to its
# autostart children; sway does too.
SOCK="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY:-wayland-1}"

uptime_s() {
    read -r up _ < /proc/uptime
    echo "${up%.*}"
}

alive() {
    test -S "$SOCK"
}

keep() {
    name=$1
    shift
    (
        quick=0
        while alive; do
            start=$(uptime_s)
            log="$LOGDIR/$name.log"
            # Keep the last run's log beside this one, and no more.
            test -f "$log" && mv -f "$log" "$log.old"
            "$@" > "$log" 2>&1
            code=$?
            alive || exit 0
            if test $(( $(uptime_s) - start )) -lt 60 ; then
                quick=$((quick + 1))
            else
                quick=0
            fi
            if test "$quick" -ge 5 ; then
                echo "lp-shell-start: $name exited $quick times in a row within a minute (last: $code); leaving it down" >> "$log"
                exit 1
            fi
            sleep 1
        done
    ) &
}

have() {
    command -v "$1" > /dev/null 2>&1
}

compositor=sway
case "${XDG_CURRENT_DESKTOP:-}" in
    *wayfire*|*Wayfire*) compositor=wayfire ;;
esac

# The loading cover: the boot screen's picture - the PC maker's logo,
# ours under it, the spinner turning - over everything while the shell
# assembles itself underneath (lp-splash-fade, drawn by the splash's own
# code so the hand-over from the boot cannot be seen). It fades when the
# sign-in screen is up (lp-lockscreen tells it) or, with nobody to sign
# in, once the shell has started (at the end of this script); --timeout
# is the most it can ever stay. Under wayfire only: a full-screen fade
# drawn by the CPU (sway, pixman) would cost more than it shows.
lp_cover=0
if test "$compositor" = wayfire && have lp-splash-fade ; then
    lp-splash-fade --timeout 12 > "$LOGDIR/splash-fade.log" 2>&1 &
    lp_cover=1
fi

# 0. Who is at the keyboard.
#
#    After a logout (lp-logout left the marker) the new session starts
#    locked: nobody gets back in without the password. (Not Try's
#    account, which has none to type: lp-lock declines to lock it.)
#
#    So does every start of the machine, unless Settings > Users named
#    this account for automatic sign-in (/etc/lp/autologin; no file
#    means ask). Nothing read that file before, and an installed machine
#    with a password came up unlocked at every boot whatever the switch
#    said. Not locked: an account with no usable password (Try's, which
#    could never unlock it), and the first session after the first-boot
#    screen, where the password was typed a moment ago. A session that
#    starts again within the same boot (the compositor died) locks too:
#    nobody has unlocked it since the boot.
lp_lock_now=0
lp_first=1
test -e "${XDG_RUNTIME_DIR}/lp-session-started" && lp_first=0
: > "${XDG_RUNTIME_DIR}/lp-session-started"
if test -e "${XDG_RUNTIME_DIR}/lp-logout" ; then
    rm -f "${XDG_RUNTIME_DIR}/lp-logout"
    lp_lock_now=1
else
    lp_auto=$(sed -n 1p /etc/lp/autologin 2> /dev/null)
    lp_pw=$(/usr/bin/passwd -S "$USER" 2> /dev/null | awk '{ print $2 }')
    if test "$lp_auto" != "$USER" && test "$lp_pw" = P ; then
        if test $lp_first = 0 || ! test -e /run/lp-session/just-set-up ; then
            lp_lock_now=1
        fi
    fi
fi
if test $lp_lock_now = 1 ; then
    # --login: the lock screen worded as signing in (lp-lockscreen).
    have lp-lock && lp-lock --login > "$LOGDIR/lock.log" 2>&1 &
fi

# Animations: on under wayfire, where the graphics card draws them. Under
# sway every frame is drawn by the CPU (and, in a VM, sent whole to the
# host), and GTK's CSS transitions - a hover fade on every button the
# pointer crosses - were most of the work behind a lagging pointer there;
# the shell's own motion (the dock's slide) still runs, as short fades
# (LP_REDUCE_MOTION). Settings (Accessibility) can turn motion down
# under either.
if have gsettings ; then
    if test -e "$HOME/.config/lp/reduce-motion" || test "$compositor" = sway ; then
        gsettings set org.gnome.desktop.interface enable-animations false
    else
        gsettings set org.gnome.desktop.interface enable-animations true
    fi 2> /dev/null
fi

# Header bars: minimise, maximise, close - the same three in every
# window under either compositor. wayfire minimises and maximises by
# itself; LP's sway does too now (desktop/compositor/sway-1.7-lp.patch),
# where stock sway ignored both and the buttons did nothing. The dock
# brings a minimised window back.
if have gsettings ; then
    gsettings set org.gnome.desktop.wm.preferences button-layout 'appmenu:minimize,maximize,close' 2> /dev/null
fi

# 1. The screen's scale first: every surface below is sized for the
#    scale it starts under, and a bar started at scale 1 on a 4K panel
#    would be drawn at a quarter size until it restarted. This is also
#    where the mode chosen in Settings > Display comes back at login,
#    under either compositor (~/.config/lp/mode-<output>, lp-autoscale).
have lp-autoscale && lp-autoscale > "$LOGDIR/autoscale.log" 2>&1
# ... and again whenever the screen changes: a VM window resized sends a
# new preferred mode, which neither compositor takes by itself (an output
# with a chosen mode stays on it).
have lp-autoscale && keep autoscale lp-autoscale --watch

# 2. Sound: pipewire, then wireplumber once pipewire is listening
#    (lp-audio-start keeps the order and stays up as long as they do).
have lp-audio-start && keep audio lp-audio-start

# 3. What applications talk to: file choosers and screen sharing
#    (portals), notifications.
test -x /usr/libexec/xdg-desktop-portal-wlr && keep portal-wlr /usr/libexec/xdg-desktop-portal-wlr
test -x /usr/libexec/xdg-desktop-portal && keep portal /usr/libexec/xdg-desktop-portal
have mako && keep mako mako

# 4. The shell. lp-desktop draws the wallpaper under everything (and the
#    icons of ~/Desktop, and the menu a long press or right click on the
#    wallpaper opens); swaybg is its stand-in only if it is missing.
if have lp-desktop ; then
    keep desktop lp-desktop
elif have swaybg ; then
    keep wallpaper swaybg -m fill -i /usr/share/backgrounds/lp/lp-wallpaper-dark-3840x2160.png
fi
if have lp-panel ; then
    keep panel lp-panel
elif have waybar ; then
    keep panel waybar
fi
have lp-dock && keep dock lp-dock

# Safe mode (start-desktop): said once, when the notifications are up, so
# nobody takes the plain look for the machine being broken.
if test "${LP_SAFE_MODE:-}" = 1 && have notify-send ; then
    case "${LANG:-}" in
        ko*) t="안전 모드"
             b="그래픽 가속 없이 최소한으로 시작했습니다. 문제가 풀렸으면 다시 시작하면 평소대로 돌아옵니다." ;;
        *)   t="Safe mode"
             b="Started with the minimum, without graphics acceleration. Restart to go back to normal once the problem is fixed." ;;
    esac
    ( sleep 5; notify-send -u critical -a LP "$t" "$b" ) &
fi
have lp-osk && keep osk lp-osk daemon
# Korean from the laptop keyboard under wayfire (session-run says why):
# fcitx5 in the foreground, so keep() can bring it back, and without its
# Wayland input-method front end - that one needs the keyboard grab
# wayfire does not give, and would take the seat's only input method
# from the on-screen keyboard.
if test "$compositor" = wayfire && have fcitx5 ; then
    keep ime fcitx5 --disable=waylandim
fi

# Settings kept in our own files that a running program must be told
# about (GSettings mirrors, night light) are put back, once per login.
have lp-settings && lp-settings --restore > "$LOGDIR/restore.log" 2>&1 &

# 5. The screen goes dark after the time Settings chose. lp-idle
#    replaces itself when Settings changes the time, so it is not kept.
have lp-idle && lp-idle > "$LOGDIR/idle.log" 2>&1 &

# Nobody to sign in: the cover goes once the bar, the dock and the
# wallpaper have had a moment for their first frames.
if test $lp_cover = 1 && test $lp_lock_now = 0 ; then
    ( sleep 2; lp-splash-fade done ) &
fi

# Stay as long as the compositor does: under sway this process is the
# parent of the loops above, and they should not outlive it.
while alive; do
    sleep 5
done
