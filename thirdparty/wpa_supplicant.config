# LP-zero 용 wpa_supplicant 설정.
#
# 주의: 이 파일은 Makefile 조각이고 빌드는 ifdef 로 검사한다.
# CONFIG_X=n 이라고 써도 "정의됨"이라 기능이 켜진다.
# 끄고 싶은 것은 줄을 아예 두지 않는다.
#
# 집 공유기에 WPA2-PSK 로 붙는 데 필요한 것만 켠다.

CONFIG_DRIVER_NL80211=y

# The second driver backend, and the reason it is here.
#
# brcmfmac is a fullmac chip: the firmware does the scanning and the
# association itself, and the host only tells it what to join. When one
# of those firmwares associates and then never starts the four-way
# handshake - which is exactly what this board does - the oldest and
# most reliable thing to try is the other path into the same driver.
# nl80211 and WEXT reach brcmfmac through different code in the kernel
# (cfg80211's WEXT compatibility layer, CONFIG_CFG80211_WEXT=y in our
# kernel), so a bug in one is not a bug in the other.
#
# Without this the binary has one backend and `-Dwext` answers
# "Unsupported driver 'wext'", so the experiment cannot even be run on
# the board that has the problem. It costs about 30KB.
CONFIG_DRIVER_WEXT=y
CONFIG_LIBNL32=y

# 자체 TLS/암호 구현. OpenSSL 을 크로스 빌드하지 않아도 된다.
# 대신 WPA3(SAE)는 쓸 수 없다 - 타원곡선 연산이 없기 때문이다.
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y

# 제어 인터페이스 (wpa_cli 로 상태 확인)
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file

# 802.11w (PMF). WPA2 에서도 쓰이고 내부 암호로 충분하다.
CONFIG_IEEE80211W=y

# 크로스 빌드 경로.
# @SYSROOT@ 는 tools/build-thirdparty.sh 가 실제 경로로 바꾼다.
# 이 파일을 손으로 쓰지 말 것 - 저장소에 있는 쪽이 원본이다.
# CFLAGS 를 명령줄에서 덮어쓰면 wpa_supplicant 자체 include 경로가
# 날아가므로 여기서 += 로 붙인다.
CFLAGS += -Os -I@SYSROOT@/include/libnl3
LIBS += -L@SYSROOT@/lib -static
LIBS_p += -L@SYSROOT@/lib -static

# ── Where wpa_supplicant's messages go ──────────────────────────────
#
# Without this, -s is not compiled in and everything wpa_supplicant
# says goes to whatever stdout it inherited - which for a service is
# the console, and the console scrolls. So there was no record at all:
# /data/log/messages held not one wireless line, and a board that
# associates and then drops in a loop gave nobody the one line that
# says why:
#
#     wlan0: CTRL-EVENT-DISCONNECTED ... reason=15
#
# reason=15 is a 4-way handshake timeout, 2 is the AP deauthenticating,
# 3 is us leaving. Which of those it is decides where to look next, and
# without it every theory stays open. Somebody spent a day ruling out
# the SSID, the passphrase, the cipher, power save, the NVRAM file and
# the firmware version - all of it work that this one line would have
# skipped.
#
# CONFIG_DEBUG_SYSLOG makes -s available; syslog on this system is the
# /dev/log datagram socket that logd already listens on, so the lines
# land in /data/log/messages with everything else and survive a reboot.
CONFIG_DEBUG_SYSLOG=y

# And -f <file>, for pointing a debugging session at its own file
# without drowning the shared log.
CONFIG_DEBUG_FILE=y
