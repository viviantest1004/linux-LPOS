#
# lp-zero-armv6.config
#
# GENERATED - do not edit. Change kernel/lp-zero-armv6.fragment and run
# tools/mkarmv6config.sh (or just build: kernel/build.sh regenerates it).
#
# The arm64 answers come first and the armv6 answers last, because
# merge_config takes the last value it sees.
#
# lp-zero.config - bcm2711_defconfig 위에 덮어쓰는 설정 조각.
#
# scripts/kconfig/merge_config.sh 로 병합한다. 여기 없는 옵션은
# defconfig 값을 그대로 쓴다.
#
# 원칙: 하드웨어가 정해져 있으므로 실제로 쓰는 것만 켠다.
# 범용 배포판은 "무엇이 꽂힐지 모른다"는 전제로 다 넣지만 우리는 안다.

# ── 모듈 지원을 통째로 끈다 ─────────────────────────────────────
# 이 한 줄이 defconfig 의 모듈 1,325개를 전부 없앤다.
# /lib/modules 도, modprobe 도, 모듈 로딩/서명 코드도 사라진다.
CONFIG_MODULES=n

# ── initramfs (우리 루트) ───────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# INITRAMFS_SOURCE 는 build.sh 가 채운다 (경로가 환경마다 다르므로)
CONFIG_INITRAMFS_COMPRESSION_GZIP=y

# ── 필수 파일시스템 ─────────────────────────────────────────────
# 가상 파일시스템 - 커널이 만들어낸다. 빼면 부팅 자체가 안 된다.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 디스크 파일시스템 - 실제로 쓰는 둘만
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# exFAT.
#
# 외장 드라이브를 자동으로 마운트하기 시작하면서 필요해졌다. 요즘
# 나오는 USB 메모리와 외장 하드는 공장 출하 상태가 거의 exFAT 이다 -
# FAT32 는 4GB 넘는 파일을 담지 못하고, NTFS 는 맥에서 쓰기가 안 되기
# 때문에 양쪽 다 쓰는 포맷으로 남은 것이 이것이다.
#
# 이게 없으면 automount 가 드라이브를 찾아내고, 파티션도 읽고, 마운트
# 단계에서만 실패한다. 사용자 입장에서는 "인식은 되는데 안 열린다" 로
# 보이고, 그게 커널 설정 한 줄 때문이라는 것은 짐작할 방법이 없다.
#
# 커널에 붙는 크기는 100KB 남짓이다.
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_UTF8=y

# 안 쓰는 디스크/네트워크 파일시스템
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_JFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_NTFS3_FS=n
CONFIG_HFS_FS=n
CONFIG_HFSPLUS_FS=n
CONFIG_UDF_FS=n
CONFIG_ISO9660_FS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_CIFS=n
CONFIG_CEPH_FS=n
CONFIG_9P_FS=n
CONFIG_ORANGEFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_MINIX_FS=n
CONFIG_ROMFS_FS=n
CONFIG_UBIFS_FS=n
CONFIG_QUOTA=n

# ── 시리얼 콘솔 ─────────────────────────────────────────────────
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=n

# ── SD / MMC (데이터 파티션) ────────────────────────────────────
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_BCM2835=y

# ── 네트워크: IPv4 만 ───────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IPV6=n
CONFIG_NETFILTER=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_IP_MULTICAST=n
CONFIG_IP_ADVANCED_ROUTER=n
CONFIG_NET_SCHED=n
CONFIG_CAN=n
CONFIG_TIPC=n
CONFIG_IP_SCTP=n
CONFIG_L2TP=n
CONFIG_MPLS=n
CONFIG_BT=n

# ── 사운드 (안 씀) ──────────────────────────────────────────────
CONFIG_SOUND=n
CONFIG_SND=n

# ── 미디어 / 카메라 (안 씀) ─────────────────────────────────────
CONFIG_MEDIA_SUPPORT=n

# ── 입력 장치: USB 키보드만 나중에. 지금은 전부 끈다 ────────────
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_MISC=n

# ── 산업용 센서 / 하드웨어 모니터 ───────────────────────────────
CONFIG_IIO=n
CONFIG_HWMON=n
CONFIG_W1=n

# ── 가상화 ──────────────────────────────────────────────────────
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n

# ── 디버그 / 트레이싱 (이미지 크기를 크게 먹는다) ───────────────
CONFIG_DEBUG_INFO_NONE=y
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_PROFILING=n
CONFIG_KALLSYMS_ALL=n
CONFIG_DEBUG_KERNEL=n
CONFIG_MAGIC_SYSRQ=n

# ── 기타 ────────────────────────────────────────────────────────
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_AIO=n
CONFIG_IO_URING=n


# ═══════════════════════════════════════════════════════════════
# 2차: 서브시스템 통째로 끄기
#
# CONFIG_MODULES=n 만으로는 부족하다. 모듈이던 옵션 중 상당수를
# olddefconfig 가 빌트인(=y)으로 승격시키기 때문이다 (=m 이 유효하지
# 않으니 기본값으로 되돌아가는데, 그 기본값이 y 인 경우가 많다).
# 실제로 1차에서 =y 가 1,895 -> 2,426 으로 늘었다.
# 그래서 서브시스템 루트 옵션을 직접 꺼야 한다.
# ═══════════════════════════════════════════════════════════════


# ── 이더넷 ─────────────────────────────────────────────────────
# Zero 2 W 에는 이더넷 포트가 없다.
CONFIG_ETHERNET=n
CONFIG_PHYLIB=n

# ── 무선: 우리 칩만 ────────────────────────────────────────────
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y

# 나머지 벤더는 전부 끈다
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_CISCO=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_PURELIFI=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_SILABS=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n

# ── 그래픽 ─────────────────────────────────────────────────────
# DRM(vc4)은 3D 가속용이라 우리에게 필요 없다. 프레임버퍼는 5차에서
# FB_BCM2708 로 켠다 (GPU 가 메일박스로 넘겨주는 버퍼를 그대로 쓴다).
CONFIG_DRM=n
CONFIG_BACKLIGHT_CLASS_DEVICE=n
CONFIG_LOGO=n

# ── 입력 장치 / HID ────────────────────────────────────────────
# 키보드를 붙일 때 되돌린다.

# ── 버스: 지금은 안 쓴다 ───────────────────────────────────────
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_MTD=n

# ── 블록 계층 부가 기능 ────────────────────────────────────────
CONFIG_MD=n
CONFIG_BLK_DEV_DRBD=n
CONFIG_STAGING=n
CONFIG_NFC=n


# ── 부팅 로그에서 실제로 확인된 불필요 항목 ────────────────────
# 1차 빌드 로그에 이것들이 전부 올라왔다. 승격된 모듈들이다.
CONFIG_CEPH_LIB=n
CONFIG_BATMAN_ADV=n
CONFIG_OPENVSWITCH=n
CONFIG_VSOCKETS=n
CONFIG_NETCONSOLE=n
CONFIG_NET_9P=n
CONFIG_ATM=n
CONFIG_6LOWPAN=n
CONFIG_IEEE802154=n
CONFIG_MAC802154=n
CONFIG_CAIF=n
CONFIG_RDS=n
CONFIG_HSR=n
CONFIG_NET_DSA=n
CONFIG_AF_KCM=n
CONFIG_SMC=n
CONFIG_XDP_SOCKETS=n
CONFIG_BPF_SYSCALL=n
CONFIG_WIRELESS_HOTKEY=n
CONFIG_SYSTEM_TRUSTED_KEYRING=n
CONFIG_MODULE_SIG=n

# ═══════════════════════════════════════════════════════════════
# 3차: 실제 크기 측정으로 찾아낸 것들
#
# 2차 빌드(20.2MB)의 vmlinux 를 뜯어 남아 있는 큰 덩어리를 확인했다.
# 설정에 명시하지 않아 defconfig 값이 그대로 살아 있던 것들이다.
# ═══════════════════════════════════════════════════════════════

# bcachefs - 신형 파일시스템. 오브젝트만 2.4MB 다.
CONFIG_BCACHEFS_FS=n
CONFIG_FUSE_FS=n

# 보안 모듈 프레임워크. AppArmor 는 크고, 우리 시스템에는 사용자가
# 하나뿐이라 강제접근제어를 쓸 일이 없다.
CONFIG_SECURITY=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_AUDIT=n

# PCI - Zero 2 W 에는 PCI 버스가 없다.
# (defconfig 가 Pi 4 의 PCIe 때문에 켜둔 것)

# SCSI comes back on further down, for USB storage. The MMC block device
# does not go through the SCSI layer, so the card reader pays nothing for
# it. What stays off is the SCSI generic passthrough interface - that is
# for talking raw commands to a device, which nothing here does.
CONFIG_BLK_DEV_BSG=n

# 컨테이너 관련. 우리는 프로세스가 열 개 남짓이고 격리가 필요 없다.
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n

# IPsec / 터널링 - 쓰지 않는다
CONFIG_XFRM_USER=n
CONFIG_INET_ESP=n
CONFIG_INET_AH=n
CONFIG_INET_IPCOMP=n
CONFIG_NET_IPGRE_DEMUX=n
CONFIG_NET_IPGRE=n
CONFIG_NET_IPIP=n

# zstd/lz4 는 쓰지 않는다 (zram 은 아래에서 LZO 를 쓴다)

# ═══════════════════════════════════════════════════════════════
# 4차: select 로 강제되던 것들의 "선택자"를 끈다
#
# 3차 후 조각 134개 중 109개는 반영됐지만 10개가 =y 로 남았다.
# kconfig 의 select 는 사용자 설정을 무시하고 심볼을 강제로 켠다.
# 그래서 대상이 아니라 "그것을 select 하는 쪽"을 꺼야 한다.
# ═══════════════════════════════════════════════════════════════

# CEPH_LIB 를 select 하던 것
CONFIG_BLK_DEV_RBD=n

# ZSTD_COMPRESS / LZ4_COMPRESS 를 select 하던 것들.
# 압축 알고리즘 자체는 initramfs 의 gzip 만 있으면 된다.
CONFIG_CRYPTO_ZSTD=n
CONFIG_CRYPTO_LZ4=n
CONFIG_CRYPTO_LZ4HC=n
CONFIG_CRYPTO_DEFLATE=n
CONFIG_CRYPTO_842=n

# CGROUPS 를 select 하던 것들
CONFIG_CHECKPOINT_RESTORE=n
CONFIG_SCHED_AUTOGROUP=n

# The SCSI upper layers. sd (disks) is switched back on with USB storage
# below; the rest has nothing to drive here - no CD-ROM, no SATA port, no
# storage arriving over the network.
CONFIG_BLK_DEV_SR=n
CONFIG_ATA=n
CONFIG_SCSI_LOWLEVEL=n
CONFIG_ISCSI_TCP=n
CONFIG_SCSI_DH=n

# SCTP
CONFIG_SCTP_COOKIE_HMAC_MD5=n
CONFIG_SCTP_COOKIE_HMAC_SHA1=n

# 디버그 부속
CONFIG_SYSCTL_EXCEPTION_TRACE=n
CONFIG_SYSTEM_DATA_VERIFICATION=n

# These were dragging the SCSI layer in on their own. ATA over Ethernet
# and AppleTalk were both switched on - that is what a general-purpose
# distribution defconfig looks like.
CONFIG_ATA_OVER_ETH=n
CONFIG_ATALK=n
CONFIG_SCSI_ISCSI_ATTRS=n
CONFIG_ISCSI_BOOT_SYSFS=n

# ═══════════════════════════════════════════════════════════════
# 5차: WiFi · SSH · 화면을 위해 다시 켜는 것들
#
# 앞 차수에서 "1단계는 시리얼만"이라며 껐던 것들 중, 이제 실제로
# 필요해진 것을 되살린다.
# ═══════════════════════════════════════════════════════════════

# ── 펌웨어 로더 ────────────────────────────────────────────────
# brcmfmac 이 /lib/firmware/brcm/ 에서 무선칩 펌웨어를 읽어 SDIO 로
# 올린다. 이게 없으면 wlan0 인터페이스 자체가 생기지 않는다.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n

# ── 의사 터미널 ────────────────────────────────────────────────
# SSH 로 들어온 세션은 PTY 위에서 돈다. 없으면 dropbear 가 셸을
# 띄우지 못한다.
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n

# ── 프레임버퍼 콘솔 (HDMI) ─────────────────────────────────────
# FB_BCM2708 은 GPU 가 메일박스로 넘겨준 프레임버퍼를 그대로 쓴다.
# DRM(vc4)보다 훨씬 작고, 우리는 3D 가속이 필요 없다.
CONFIG_FB=y
CONFIG_FB_BCM2708=y
CONFIG_FB_CORE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y

# ── 무선 데이터 경로 암호 ──────────────────────────────────────
# WPA2 의 4-way 핸드셰이크는 wpa_supplicant(유저스페이스)가 하지만,
# 실제 데이터 암복호(CCMP)는 커널 mac80211 이 한다.
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SHA256=y

# 콘솔 커맨드라인: 시리얼과 화면 양쪽에 뿌린다.
# 마지막 console= 이 /dev/console 이 되므로 tty1(화면)을 뒤에 둔다.
# The order of console= matters, and it is easy to get wrong.
#
# printk goes to every console that is registered, but /dev/console -
# which is what init and the shell write to - maps to the LAST one
# listed. With console=tty1 last, kernel messages still reach the serial
# port while every byte of userspace output disappears into a virtual
# terminal with no screen attached. That looks exactly like a hang right
# after "Run /init as init process".
#
# So ttyAMA0 goes last. tty1 stays ahead of it, which still gets kernel
# messages onto an HDMI screen when one is plugged in.
#
# This only applies when nothing else supplies a command line: on real
# hardware the GPU firmware passes cmdline.txt through the device tree,
CONFIG_CMDLINE="console=tty1 console=ttyAMA0,115200 rootwait fbcon=font:TER16x32 loglevel=4 rootflags=size=48M"

# ═══════════════════════════════════════════════════════════════
# 6차: zram (RAM 압축 스왑)
#
# 앞에서 CONFIG_SWAP=n 으로 스왑을 아예 껐었다. 이유는 SD 스왑이
# 25MB/s 라 시스템을 멈추게 만들고 카드 수명도 깎기 때문이었다.
# 그 판단 자체는 유효하다 - 우리는 SD 로는 절대 스왑하지 않는다.
#
# 다만 zram 은 성격이 다르다. 스왑 대상을 RAM 안에 두고 압축해서
# 보관한다. SD 에 한 바이트도 쓰지 않고, 보통 3배쯤 압축되므로
# 512MB 를 더 넉넉하게 쓸 수 있다. 안드로이드와 크롬OS 가 저사양
# 기기에서 쓰는 방식이다.
#
# zram 은 스왑 블록장치라서 CONFIG_SWAP 이 필요하다. 켜지만
# 스왑 대상은 zram0 하나뿐이고 SD 파티션을 스왑으로 쓰지 않는다.
# ═══════════════════════════════════════════════════════════════
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# 압축 알고리즘. LZO 는 압축률보다 속도가 좋아 스왑에 적합하다.
# (A53 처럼 느린 CPU 에서는 압축 시간이 곧 지연이 된다)
CONFIG_CRYPTO_LZO=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y

# 메모리 압박 시 커널 동작. guard 가 먼저 개입하지만
# 최후의 보루로 OOM Killer 는 남겨둔다.
CONFIG_MEMCG=n

# ═══════════════════════════════════════════════════════════════
# 7차: USB (이더넷) · virtio
#
# 앞에서 "WiFi 가 SDIO 라 USB 가 필요 없다"며 USB 를 통째로 껐다.
# 유선 연결을 넣기로 하면서 되살린다.
#
# Zero 2 W 에는 이더넷 포트가 없다. micro USB(OTG) 포트로 두 가지를 한다:
#   호스트 모드 - USB 이더넷 어댑터를 꽂는다 (진짜 랜선)
#   가젯 모드   - Pi 가 PC 에게 USB 네트워크 장치로 보인다
#                 케이블 하나로 PC 에서 SSH 가 된다. 공유기도 WiFi 도
#                 필요 없어서 초기 설정에 특히 유용하다.
# ═══════════════════════════════════════════════════════════════
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# Zero 2 W 의 USB 컨트롤러. 호스트/가젯 양쪽을 다 할 수 있다.
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y

# ── 호스트 모드: USB 이더넷 어댑터 ─────────────────────────────
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y        # 표준 CDC. 대부분의 어댑터가 지원한다
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_SMSC95XX=y        # 라즈베리파이 3B 계열에 쓰이던 칩
CONFIG_USB_NET_AX88179_178A=y    # ASIX. 기가비트 어댑터에 흔하다
CONFIG_USB_RTL8152=y             # Realtek. 저가 어댑터에 흔하다

# ── 가젯 모드: Pi 를 USB 네트워크 장치로 ───────────────────────
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_ECM=y               # 리눅스/맥 호스트용
CONFIG_USB_F_RNDIS=y             # 윈도우 호스트용
CONFIG_USB_ETH=y                 # g_ether. 위 둘을 묶어 제공한다
CONFIG_USB_ETH_RNDIS=y

# ── Host mode: USB storage ────────────────────────────────────
# A USB stick, a card reader, an SSD in an enclosure. Three different
# reasons this has to work:
#
#   The board    the Zero 2 W boots from its SD card, but a USB disk is
#                the sane place to keep data - it is faster than the card
#                and it does not wear out from writes the way a cheap
#                card does.
#   UTM          on iOS the drive is often attached over USB rather than
#                VirtIO, and then this is the only way the disk is seen
#                at all.
#   Recovery     plugging the card into another machine is not always an
#                option. A stick is.
#
# A USB disk arrives through the SCSI layer: usb-storage speaks the
# Bulk-Only Transport, hands the commands to the SCSI core, and sd binds
# to what comes out as /dev/sda. So all three have to be on.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# UAS is the faster transport newer enclosures offer. Both QEMU and UTM
# emulate plain Bulk-Only, and on the Zero 2 W the USB 2.0 bus is the
# bottleneck long before the transport is, so it buys nothing here.
# CONFIG_USB_UAS is not set

# Host controllers. DWC2 above is the board's own. A virtual machine has
# a PCI one instead, and which one depends on what the user picked:
# UTM's "USB 3.0" and QEMU's qemu-xhci are XHCI, "USB 2.0" is EHCI.
# Both are cheap, and having only one of them means the disk silently
# does not appear.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y

# The Renesas controllers need a firmware blob uploaded before they run.
# That is a PCIe card in a desktop, not anything we will meet.
# CONFIG_USB_XHCI_PCI_RENESAS is not set

# ── PCI (가상머신용) ──────────────────────────────────────────
# Pi Zero 2 W 에는 PCI 가 없다. 그런데 이걸 켜야 UTM 과 QEMU 에서
# 같은 커널이 돈다.
#
# QEMU 의 virt 머신과 UTM 은 기본으로 virtio 장치를 PCI 에 붙인다
# (virtio-blk-pci). PCI 가 없으면 커널이 디스크를 아예 못 봐서
# /data 가 안 붙고 파이썬도 없는 상태로 셸만 뜬다. QEMU 에서는
# -device virtio-blk-device 로 MMIO 를 강제할 수 있지만 UTM 에는
# 그런 설정이 없다.
#
# 실기에서는 PCI 버스가 없으니 이 코드는 스캔만 하고 끝난다.
# no disk, no network. The symptom is a boot that stops dead right after
#
# SPCR is what tells us which serial port is the console in that case.

# ── Display ───────────────────────────────────────────────────
# Two very different paths end up at the same text console.
#
#   The board      the GPU firmware sets up a framebuffer for HDMI and
#                  hands its address over through the mailbox. FB_BCM2708
#                  drives that. No 3D, no KMS - we only want text.
#   A VM window    UTM and QEMU put a virtio-gpu on the PCI bus. That
#                  needs the DRM stack; without it the window stays black
#                  no matter what the firmware did.
#
# DRM_FBDEV_EMULATION is what makes a DRM driver produce the /dev/fb0
# that fbcon draws the console on. Without it we would have a working
# GPU driver and still no visible text.
#
# This costs about 2MB. It is the price of seeing a shell on a screen.
CONFIG_DRM=y

#
# The comment above says "no KMS - we only want text", and that was true
# while text was all this could do. It stopped being true when the amd64
# build got a real graphics stack: anything that draws - X11, Wayland, a
# toolkit - opens /dev/dri and talks KMS, and the firmware framebuffer
# virtual machine and not on the hardware this system was written for,
# which is the wrong way round.
#
# a compositor does not need it to put a window on the screen, and the
# Zero 2 W is not the board anyone renders on.

# A console font you can read across a room.
#
# The 8x16 default gives 240x67 characters on a 1080p TV, which is
# unreadable from a sofa, and squints on a phone screen in UTM.
# Terminus 16x32 gives 120x33 instead. fbcon picks it by name from the
# kernel command line.
CONFIG_FONT_TER16x32=y

# the kernel ignores that and the VM window stays black - you would have
# to switch the VM to serial console mode to see anything.
#
# We have no DRM and no virtio-gpu driver, so this handover is the only
# way a graphical VM shows the console. It costs about 10KB.
#
# On the Pi none of this runs: there the GPU firmware sets up the
# framebuffer and FB_BCM2708 drives it.
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y


# ── virtio (가상머신) ─────────────────────────────────────────
# 실기에는 없지만 이게 있어야 QEMU/UTM 에서 저장장치와 네트워크까지
# 검증할 수 있다. 없으면 부팅과 셸까지밖에 확인하지 못한다.
# MMIO 와 PCI 두 방식을 다 넣는다 - 호스트마다 붙이는 방식이 다르다.


# ── Build for size, not for speed ─────────────────────────────
# The kernel is stored uncompressed, so every byte is a byte the board
# reads off the SD card before anything runs. At roughly 20MB/s that is
# real boot time, and -Os took 24.4MB down to 22.0MB.
#
# The usual argument against -Os is slower code, but this kernel spends
# its life waiting on a shell, a socket and an SD card, not in tight
# loops - and reading 2.4MB less costs about 0.12s less at boot.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# 32-bit ARM userspace. Nothing here is 32-bit: our own programs, dropbear,
# wpa_supplicant, CPython and MicroPython are all aarch64. Carrying the
# compat syscall layer for binaries that do not exist is pure weight.
# (Turning this back on is the fix if a 32-bit Pi binary is ever needed.)

# Symbol names for every symbol, not just the exported ones. Useful in an
# oops trace, and we keep plain KALLSYMS for that, but the "all" variant
# is a debugging luxury.
# CONFIG_KALLSYMS_ALL is not set


# ═══ Server essentials ═══════════════════════════════════════════
#
# Things every other distribution has on day one and we did not.

# ── IPv6 ──
# Not optional any more: mobile networks and many ISPs hand out IPv6
# only, and a device that speaks IPv4 alone silently fails to reach
# half the internet. The stack costs a few hundred KB.
CONFIG_IPV6=y
# CONFIG_IPV6_SIT is not set   # turned off further down

# ── Firewall ──
# A board on the open internet with no packet filter is one open port
# away from trouble. This is the netfilter core plus the pieces a
# simple "allow SSH and established, drop the rest" policy needs.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NETFILTER_NETLINK=y

# ── SPI ──
# The bus e-ink panels, ADCs and most sensor breakouts speak. Without
# it the kernel does not even know an SPI device exists, so a display
# plugged into the header is invisible.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_BCM2835=y
CONFIG_SPI_BCM2835AUX=y
CONFIG_SPI_SPIDEV=y

# I2C goes with it - the other half of the sensor world, and how a
# battery-backed clock module (DS3231) would attach.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BCM2835=y

# ═══ Weight that was never used ══════════════════════════════════
# A simulated WiFi radio for testing mac80211, and a fake GPIO chip
# for testing gpiolib. Both are test scaffolding for kernel
# developers. On a real board they do nothing but take up space.
# CONFIG_MAC80211_HWSIM is not set
# CONFIG_GPIO_MOCKUP is not set

# CONFIG_DEBUG_KERNEL cannot be turned off here: EXPERT selects it, and
# we need EXPERT to disable base features at all. It is only a menu gate
# though - the weight is in the individual options below.


# A watchdog QEMU can provide, so the reboot-on-hang path is testable
# somewhere other than the board itself. About 8KB. On the Pi it is
# BCM2835_WDT that binds; this driver simply finds no device.
CONFIG_I6300ESB_WDT=y

# ═══ Cutting what this board will never run ══════════════════════
#
# Measured, not guessed: each of these was actually compiled into the
# kernel we were shipping.

# Datacenter networking. A load balancer, overlay tunnels, link
# aggregation across several NICs, a cluster lock manager. This board
# has one WiFi radio.
# CONFIG_IP_VS is not set
# CONFIG_IP_SET is not set
# CONFIG_VXLAN is not set
# CONFIG_MACVLAN is not set
# CONFIG_BONDING is not set
# CONFIG_VETH is not set
# CONFIG_DLM is not set

# Protocols nothing here speaks. SCTP is telecom signalling; MPTCP
# splits a connection across several links, and we have one.
# CONFIG_IP_SCTP is not set
# CONFIG_MPTCP is not set

# The legacy iptables machinery. We use nftables, which replaced it.
# CONFIG_NETFILTER_XTABLES is not set

# A CIFS/SMB *server* was being built into the kernel. Also filesystems
# nothing will ever mount: ReiserFS was removed from Linux upstream,
# SquashFS is for read-only images, eCryptfs is deprecated, and
# overlayfs is for containers.
# CONFIG_SMB_SERVER is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_ECRYPT_FS is not set
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y

# Infrared remote control receivers.
# CONFIG_RC_CORE is not set
# CONFIG_MEDIA_SUPPORT is not set

# Drivers for specific game controllers and tablets. HID_GENERIC
# handles an ordinary USB keyboard, which is all we need on a screen.
# CONFIG_HID_WACOM is not set
# CONFIG_HID_LOGITECH is not set
# CONFIG_HID_WIIMOTE is not set
# CONFIG_HID_SONY is not set
# CONFIG_HID_APPLE is not set
# CONFIG_HID_DEBUG is not set

# USB-to-serial adapters (FTDI cables, 3G modems). The board's own
# serial console is on the header pins and needs none of this.
# CONFIG_USB_SERIAL is not set

# The 3D engine and DSI panel drivers. We drive a text console on a
# framebuffer - there is no 3D and no ribbon-cable panel.

# Debugging surfaces. Verbose BUG() output stays (it is what makes a
# crash readable); the rest is for someone bringing up a board.
# CONFIG_DEBUG_MISC is not set
# CONFIG_MAGIC_SYSRQ is not set

# ═══════════════════════════════════════════════════════════════
# Recovering on its own
#
# This board sits on a shelf with no keyboard and no screen. Anything
# that needs a person standing next to it is, in practice, a board that
# stays broken until someone notices.
# ═══════════════════════════════════════════════════════════════

# A kernel panic stops dead by default and waits forever. That is right
# for a developer reading the backtrace off a serial cable and wrong for
# everything else: the message has already gone to the serial console
# either way, and after ten seconds a reboot is strictly better than a
# board that is simply gone. The hardware watchdog covers the case where
# the kernel is too far gone to even reach this code.
CONFIG_PANIC_TIMEOUT=10

# A task stuck in an uninterruptible wait for two minutes is a bug -
# usually storage that stopped answering. This prints it with a
# backtrace, which logd then keeps on the data partition, so the reason
# survives the reboot that follows.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
# Report it. Do not panic over it - the process is stuck, not the kernel.
# CONFIG_BOOTPARAM_HUNG_TASK_PANIC is not set

# The thermal framework: it reads the SoC sensor and clocks the CPU down
# as it heats up. This is the layer under guard - guard holds the CPU at
# its lowest speed as a policy, while this is the kernel's own reflex,
# and the firmware's hard limit sits under both.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y

# Frequency scaling. Idle cores drop to 600MHz instead of sitting at
# 1GHz, which is both the power saving and the headroom that keeps the
# chip away from its thermal limit in the first place. ondemand is also
# what guard puts back after it has held the CPU down.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_ARM_RASPBERRYPI_CPUFREQ=y

# ═══════════════════════════════════════════════════════════════
# Network drivers for hardware that is not here
#
# ifconfig listed yam0 through yam3 and bcsf0 on a board with one WiFi
# chip. They are amateur radio packet modems - drivers for kit that
# attaches to a serial port and has not been sold for twenty years. The
# defconfig carries them because it is written for every Raspberry Pi
# anyone might own, running anything.
#
# The cost is not only the space. Every one of them registers an
# interface, so anyone looking at this machine's network has to work out
# which five of the ten listed are real.
# ═══════════════════════════════════════════════════════════════

# Amateur radio: AX.25 and everything selected by it.
# CONFIG_HAMRADIO is not set
# CONFIG_AX25 is not set
# CONFIG_NETROM is not set
# CONFIG_ROSE is not set
# CONFIG_MKISS is not set
# CONFIG_BPQETHER is not set
# CONFIG_BAYCOM_SER_FDX is not set
# CONFIG_BAYCOM_SER_HDX is not set
# CONFIG_YAM is not set

# A loopback that is not lo, for testing routing setups we do not have.
# CONFIG_DUMMY is not set

# Traffic shaping on the way in, which needs a shaper to be configured
# for it and there is none.
# CONFIG_IFB is not set

# IP over a serial line. The serial port here is the console; putting a
# network on it would take away the one way in when everything else is
# broken.
# CONFIG_SLIP is not set

# WireGuard. A good VPN, and 40KB of one nothing on this board is asked
# to do. It comes back the moment there is a reason.
# CONFIG_WIREGUARD is not set

# Tunnel devices. Four more interfaces in every listing, for carrying one
# protocol inside another:
#   ip_vti0, ip6_vti0   IPsec tunnels, and IPsec is already off
#   sit0                IPv6 over IPv4, for reaching IPv6 from a network
#                       that has none. A router either offers IPv6 or it
#                       does not; this board is not going to tunnel its
#                       way to it.
#   ip6tnl0             IPv6 inside IPv6
# IPv6 itself stays on. This is the tunnelling, not the protocol.
# CONFIG_NET_IPVTI is not set
# CONFIG_IPV6_VTI is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_IPV6_TUNNEL is not set

# ═══════════════════════════════════════════════════════════════
# Weight, and one thing that should not have been on at all
# ═══════════════════════════════════════════════════════════════

# The kernel debugger, reachable over the serial console.
#
# This is not only weight. KGDB on the console means anyone who can
# reach the serial pins - or a serial console left connected - can stop
# the kernel and read or write any memory in the machine. On a board
# whose whole access control is one SSH key, that is a second door with
# no lock on it.
#
# It also selects KALLSYMS_ALL, which is the full symbol table: names
# that exist so a debugger can print them.
# CONFIG_KGDB is not set
# CONFIG_KGDB_SERIAL_CONSOLE is not set
# CONFIG_KGDB_KDB is not set
# CONFIG_KALLSYMS_ALL is not set

# Pin controllers for the Raspberry Pi 5. Different silicon entirely -
# RP1 is the south bridge on a board this one will never be.
# CONFIG_PINCTRL_RP1 is not set

# A random number generator inside a TPM chip. There is no TPM here, and
# the SoC has its own hardware RNG which is already on.
# CONFIG_HW_RANDOM_TPM is not set

# but a VM does not have GPIO pins and the board describes its own
# through the device tree.

# Display panel drivers - fourteen of them, for specific LCD modules
# that attach to the DSI ribbon connector. We drive a text console on
# whatever framebuffer HDMI or the VM gives us; none of these is that.

#
# wrapped in a small stub that decompresses it. Roughly half the size.
#
# boot services, and the Raspberry Pi's GPU firmware provides none - it
# loads the file named by kernel= and jumps to it. So the board keeps
# and the virtual machine image gets to be half the size.
CONFIG_KERNEL_GZIP=y

# LATENCYTOP - a measuring tool for scheduler latency, and the reason
# the full symbol table kept coming back.
#
# It selects KALLSYMS_ALL, which puts the name of every symbol in the
# kernel - not just the functions - into the image, permanently in RAM.
# That is a megabyte spent so that a tool nobody here runs could print
# nicer stack traces. Plain KALLSYMS stays on, which is what an oops
# needs.
# CONFIG_LATENCYTOP is not set

# ── 'ps' 가 보여준 것들 ─────────────────────────────────────────
#
# 부팅한 기계에서 ps 를 돌려보고 나서 지운 것들이다. 커널 스레드가
# 눈에 보이면 무엇이 켜져 있는지가 설정 파일을 읽는 것보다 정직하게
# 드러난다. 아래 넷은 전부 이 보드에서 쓸 일이 없고, 앞의 셋은
# 공격 표면이기도 하다.

# 네트워크 블록 장치. 원격 서버의 디스크를 로컬 디스크처럼 붙인다.
# 헤드리스 SSH 보드에서 이것이 켜져 있을 이유가 없고, 켜져 있으면
# 커널이 네트워크에서 온 블록 요청을 처리하는 코드를 안고 있게 된다.
# nbd0~nbd15 의 커널 스레드 16개도 함께 사라진다.
# CONFIG_BLK_DEV_NBD is not set

# USB over IP. USB 장치를 네트워크 너머로 붙이는 프로토콜이다.
# 호스트 쪽(USBIP_HOST)은 이 보드의 USB 장치를 남에게 내주는 기능이다.
# CONFIG_USBIP_CORE is not set
# CONFIG_USBIP_VHCI_HCD is not set
# CONFIG_USBIP_HOST is not set
# CONFIG_USBIP_VUDC is not set

# 패킷 생성기. 커널 안에 들어 있는 트래픽 발생 도구다. 성능 시험용이고,
# 이 보드에서는 쓸 일이 없다.
# CONFIG_NET_PKTGEN is not set

# 화면 낭독기. 화면이 없는 기계에서는 아무 일도 하지 않는다.
# CONFIG_SPEAKUP is not set
# CONFIG_SPEAKUP_SYNTH_SOFT is not set

# USB 마우스·터치스크린 HID 드라이버. 이 보드에 붙을 일이 없다.
# CONFIG_HID_ELO is not set
# CONFIG_HID_MAGICMOUSE is not set
# CONFIG_USB_IDMOUSE is not set

# ── The one USB device controller ──────────────────────────────
# g_zero is a test gadget: it answers as a device that does nothing,
# for exercising a UDC driver. It is not useful here, and on a board
# with exactly one controller it is worse than useless - in
# drivers/usb/gadget/legacy/Makefile g_zero.o links before g_ether.o,
# so it claims the UDC first and the ethernet gadget never binds. The
# boot log says "UDC core: g_ether: couldn't find an available UDC"
# and the USB network link, which is the way into a board whose WiFi
# is misbehaving, is simply not there.
CONFIG_USB_ZERO=n

# ── The console font ───────────────────────────────────────────
# CONFIG_FONTS is the "choose which fonts to build" menu. Without it
# only the default 8x16 is compiled in, and fbcon quietly falls back to
# it - so cmdline.txt asking for font:TER16x32 did nothing at all, and
# nothing said so. On a 1080p screen 8x16 is about two millimetres tall.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_FONT_8x16=y

# ── WiFi power save: off, in the kernel ─────────────────────────────
#
# This is the one that costs you the network.
#
# CONFIG_CFG80211_DEFAULT_PS=y comes in from the Raspberry Pi defconfig
# and means cfg80211 turns power save on for every wireless interface as
# it is created. On a BCM43430 the chip then sleeps between beacons -
# and the AP sends EAPOL 1/4, the first frame of the WPA2 handshake,
# immediately after association, to a station that is asleep.
#
# What that looks like from outside is exactly what the board did:
#
#     wlan0: Associated with 5a:86:94:4c:53:94
#     wlan0: Authentication with 5a:86:94:4c:53:94 timed out.
#     wlan0: Added BSSID into ignore list
#
# with 33 packets received (beacons, which arrive at TIM boundaries and
# wake it) and not one EAPOL frame. It reads like a wrong passphrase and
# is not: a wrong key gets you 4-Way Handshake failed, because the
# frames arrive and the maths fails. Here nothing arrives at all.
#
# There was already a defence against this - `net powersave off wlan0`
# in /etc/rc - and it is still there. But it is a userspace command
# speaking generic netlink that has never once been shown to work on a
# board, because qemu-user permits only NETLINK_ROUTE and there was no
# other way to run it. Depending on it was the mistake. Turned off in
# the kernel, the chip never enables power save in the first place, on
# the very first association, with nothing having to run correctly
# first.
#
# The cost is idle current: a few tens of milliamps on a board that is
# mains-powered and whose entire purpose is answering the network.
CONFIG_CFG80211_DEFAULT_PS=n

# ── The regulatory database ─────────────────────────────────────────
#
# The boot log says, on every boot:
#
#     platform regulatory.0: Direct firmware load for regulatory.db
#                            failed with error -2
#     cfg80211: failed to load regulatory.db
#
# and it is right - the file was never put on the image. Without it
# cfg80211 falls back to the world domain, which is the most
# conservative set of rules there is: reduced power, and several
# channels marked no-IR, meaning the station may not transmit on them
# until it has heard a beacon. A marginal link on a board sitting next
# to its router is what that looks like.
#
# The file itself is data, not code - it is fetched by
# tools/fetch-wifi-fw.sh with its signature (regulatory.db.p7s), which
# the kernel checks against the certificates it says it loaded on the
# line above.

# ══ armv6 answers, last so they win ═══════════════════════════
# lp-zero-armv6.fragment - what a Pi Zero W needs that a Zero 2 W does not.
#
# Read after the arm64 answers (see tools/mkarmv6config.sh), so anything
# here wins.
#
# The board: BCM2835, one ARM1176JZF-S core at 1GHz, 512MB, no ethernet,
# a BCM43438 for WiFi on SDIO, and micro-USB in OTG mode. The chip is
# ARMv6K - not a smaller ARMv8, a different instruction set. Nothing
# built for the Zero 2 W runs on it.

# ── The processor ──────────────────────────────────────────────
# bcmrpi_defconfig already selects ARCH_MULTI_V6 and CPU_V6; these are
# here so the build fails loudly rather than quietly producing an ARMv7
# kernel that halts on the first instruction the chip does not have.
CONFIG_ARCH_MULTI_V6=y
CONFIG_ARCH_MULTI_V7=n
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_AEABI=y
# The old ABI is a second syscall path with different structure layouts,
# kept for binaries built before 2005. Ours are not.
CONFIG_OABI_COMPAT=n
# VFPv2, which this chip has. NEON, which it does not, is off by not
# being selectable on ARMv6 at all.
CONFIG_VFP=y
CONFIG_NEON=n
# One core. SMP on a single-core chip costs locks and memory for nothing.
CONFIG_SMP=n

# ── Memory ─────────────────────────────────────────────────────
# 512MB, all of it below 1GB, so there is no high memory to map.
CONFIG_HIGHMEM=n
# 4KB pages. The 16KB/64KB choices are arm64-only anyway; saying it here
# keeps the answer in one place.
CONFIG_PAGE_SIZE_4KB=y

# ── Boot ───────────────────────────────────────────────────────
# The GPU firmware loads a zImage - a kernel with its own decompressor
# stuck to the front - and jumps to it. There is no UEFI on this board
# and no second compressed copy to build.
CONFIG_ZBOOT_ROM=n
# The device tree comes from start.elf, which patches in the memory size
# and the board serial number before handing it over. Building the DTBs
# is what puts bcm2708-rpi-zero-w.dtb where mksdcard.sh can find it.
CONFIG_ATAGS=n
CONFIG_USE_OF=y
CONFIG_ARM_APPENDED_DTB=n

# ── Serial console ─────────────────────────────────────────────
# Same as the Zero 2 W: PL011 is wired to the Bluetooth chip by default
# and the disable-bt overlay moves it to the header pins. The mini UART
# (8250) stays off - its baud rate follows the core clock, which moves.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ── USB ────────────────────────────────────────────────────────
# One micro-USB port in OTG mode: a hub and an ethernet adapter through
# a gender changer, or a network link to a PC. dwc2, not dwc_otg - the
# mainline driver, which is what this tree's ARCH_BCM2835 selects.
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y

# ── Wireless ───────────────────────────────────────────────────
# BCM43438 on SDIO. Same driver and same firmware directory as the
# Zero 2 W; only the firmware file name differs, and brcmfmac picks that
# from the device tree.
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_BCM2835=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y

# ── Framebuffer ────────────────────────────────────────────────
# The GPU hands over a linear framebuffer through the mailbox; fbcon
# draws the console on it. No DRM, no 3D - there is no GPU driver on
# this board worth the megabytes.
CONFIG_FB=y
CONFIG_FB_BCM2708=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_TER16x32=y

# ── Size ───────────────────────────────────────────────────────
# One core at 1GHz reading from an SD card. Every megabyte of kernel is
# a megabyte of RAM that never comes back, because the root filesystem
# lives inside the kernel image.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# ── Power domains ──────────────────────────────────────────────
# Two drivers claim to do this and only one of them is right here.
#
# BCM2835_POWER talks to the ASB registers directly. RASPBERRYPI_POWER
# asks the GPU firmware. The device tree for this board names
# "raspberrypi,bcm2835-power" - the firmware one - for USB, HDMI, the
# camera interfaces and V3D, and the kernel's own help text says that
# once the firmware owns a domain, Linux must go through the firmware
# for it. So the ASB driver has no domains to manage and is loaded only
# because bcm2835-pm adds it as a second cell next to the watchdog.
#
# It is not harmless. On a machine where those registers do not answer
# it takes an external abort inside its probe, in a kworker, with
# interrupts disabled - which ends the boot at about two seconds, with
# the last line on the console being the watchdog registering.
CONFIG_BCM2835_POWER=n
CONFIG_RASPBERRYPI_POWER=y

# ── The one USB device controller ──────────────────────────────
# g_zero is a test gadget: it answers as a device that does nothing,
# for exercising a UDC driver. It is not useful here, and on a board
# with exactly one controller it is worse than useless - in
# drivers/usb/gadget/legacy/Makefile g_zero.o links before g_ether.o,
# so it claims the UDC first and the ethernet gadget never binds. The
# boot log says "UDC core: g_ether: couldn't find an available UDC"
# and the USB network link, which is the way into a board whose WiFi
# is misbehaving, is simply not there.
CONFIG_USB_ZERO=n

# ── The console font ───────────────────────────────────────────
# CONFIG_FONTS is the "choose which fonts to build" menu. Without it
# only the default 8x16 is compiled in, and fbcon quietly falls back to
# it - so cmdline.txt asking for font:TER16x32 did nothing at all, and
# nothing said so. On a 1080p screen 8x16 is about two millimetres tall.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_FONT_8x16=y

# ── WiFi power save: off, in the kernel ─────────────────────────────
#
# This is the one that costs you the network.
#
# CONFIG_CFG80211_DEFAULT_PS=y comes in from the Raspberry Pi defconfig
# and means cfg80211 turns power save on for every wireless interface as
# it is created. On a BCM43430 the chip then sleeps between beacons -
# and the AP sends EAPOL 1/4, the first frame of the WPA2 handshake,
# immediately after association, to a station that is asleep.
#
# What that looks like from outside is exactly what the board did:
#
#     wlan0: Associated with 5a:86:94:4c:53:94
#     wlan0: Authentication with 5a:86:94:4c:53:94 timed out.
#     wlan0: Added BSSID into ignore list
#
# with 33 packets received (beacons, which arrive at TIM boundaries and
# wake it) and not one EAPOL frame. It reads like a wrong passphrase and
# is not: a wrong key gets you 4-Way Handshake failed, because the
# frames arrive and the maths fails. Here nothing arrives at all.
#
# There was already a defence against this - `net powersave off wlan0`
# in /etc/rc - and it is still there. But it is a userspace command
# speaking generic netlink that has never once been shown to work on a
# board, because qemu-user permits only NETLINK_ROUTE and there was no
# other way to run it. Depending on it was the mistake. Turned off in
# the kernel, the chip never enables power save in the first place, on
# the very first association, with nothing having to run correctly
# first.
#
# The cost is idle current: a few tens of milliamps on a board that is
# mains-powered and whose entire purpose is answering the network.
CONFIG_CFG80211_DEFAULT_PS=n

# ── The regulatory database ─────────────────────────────────────────
#
# The boot log says, on every boot:
#
#     platform regulatory.0: Direct firmware load for regulatory.db
#                            failed with error -2
#     cfg80211: failed to load regulatory.db
#
# and it is right - the file was never put on the image. Without it
# cfg80211 falls back to the world domain, which is the most
# conservative set of rules there is: reduced power, and several
# channels marked no-IR, meaning the station may not transmit on them
# until it has heard a beacon. A marginal link on a board sitting next
# to its router is what that looks like.
#
# The file itself is data, not code - it is fetched by
# tools/fetch-wifi-fw.sh with its signature (regulatory.db.p7s), which
# the kernel checks against the certificates it says it loaded on the
# line above.
