#
# lp-zero-amd64.config
#
# GENERATED - do not edit. Change kernel/lp-zero-amd64.fragment and run
# tools/mkamd64config.sh (or just build: kernel/build.sh regenerates it).
#
# The arm64 answers come first and the amd64 answers last, because
# merge_config takes the last value it sees.
#
# lp-zero.config - bcm2711_defconfig 위에 덮어쓰는 설정 조각.
#
# scripts/kconfig/merge_config.sh 로 병합한다. 여기 없는 옵션은
# defconfig 값을 그대로 쓴다.
#
# 원칙: 하드웨어가 정해져 있으므로 실제로 쓰는 것만 켠다.
# 범용 배포판은 "무엇이 꽂힐지 모른다"는 전제로 다 넣지만 우리는 안다.

# ── 모듈 지원을 통째로 끈다 ─────────────────────────────────────
# 이 한 줄이 defconfig 의 모듈 1,325개를 전부 없앤다.
# /lib/modules 도, modprobe 도, 모듈 로딩/서명 코드도 사라진다.
CONFIG_MODULES=n

# ── initramfs (우리 루트) ───────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# INITRAMFS_SOURCE 는 build.sh 가 채운다 (경로가 환경마다 다르므로)
CONFIG_INITRAMFS_COMPRESSION_GZIP=y

# ── 필수 파일시스템 ─────────────────────────────────────────────
# 가상 파일시스템 - 커널이 만들어낸다. 빼면 부팅 자체가 안 된다.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 디스크 파일시스템 - 실제로 쓰는 둘만
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# exFAT.
#
# 외장 드라이브를 자동으로 마운트하기 시작하면서 필요해졌다. 요즘
# 나오는 USB 메모리와 외장 하드는 공장 출하 상태가 거의 exFAT 이다 -
# FAT32 는 4GB 넘는 파일을 담지 못하고, NTFS 는 맥에서 쓰기가 안 되기
# 때문에 양쪽 다 쓰는 포맷으로 남은 것이 이것이다.
#
# 이게 없으면 automount 가 드라이브를 찾아내고, 파티션도 읽고, 마운트
# 단계에서만 실패한다. 사용자 입장에서는 "인식은 되는데 안 열린다" 로
# 보이고, 그게 커널 설정 한 줄 때문이라는 것은 짐작할 방법이 없다.
#
# 커널에 붙는 크기는 100KB 남짓이다.
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_UTF8=y

# 안 쓰는 디스크/네트워크 파일시스템
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_JFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_NTFS3_FS=n
CONFIG_HFS_FS=n
CONFIG_HFSPLUS_FS=n
CONFIG_UDF_FS=n
CONFIG_ISO9660_FS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_CIFS=n
CONFIG_CEPH_FS=n
CONFIG_9P_FS=n
CONFIG_ORANGEFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_MINIX_FS=n
CONFIG_ROMFS_FS=n
CONFIG_UBIFS_FS=n
CONFIG_QUOTA=n

# ── 시리얼 콘솔 ─────────────────────────────────────────────────
CONFIG_SERIAL_8250=n

# ── SD / MMC (데이터 파티션) ────────────────────────────────────
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y

# ── 네트워크: IPv4 만 ───────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IPV6=n
CONFIG_NETFILTER=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_IP_MULTICAST=n
CONFIG_IP_ADVANCED_ROUTER=n
CONFIG_NET_SCHED=n
CONFIG_CAN=n
CONFIG_TIPC=n
CONFIG_IP_SCTP=n
CONFIG_L2TP=n
CONFIG_MPLS=n
CONFIG_BT=n

# ── 사운드 (안 씀) ──────────────────────────────────────────────
CONFIG_SOUND=n
CONFIG_SND=n

# ── 미디어 / 카메라 (안 씀) ─────────────────────────────────────
CONFIG_MEDIA_SUPPORT=n

# ── 입력 장치: USB 키보드만 나중에. 지금은 전부 끈다 ────────────
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_MISC=n

# ── 산업용 센서 / 하드웨어 모니터 ───────────────────────────────
CONFIG_IIO=n
CONFIG_HWMON=n
CONFIG_W1=n

# ── 가상화 ──────────────────────────────────────────────────────
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n

# ── 디버그 / 트레이싱 (이미지 크기를 크게 먹는다) ───────────────
CONFIG_DEBUG_INFO_NONE=y
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_PROFILING=n
CONFIG_KALLSYMS_ALL=n
CONFIG_DEBUG_KERNEL=n
CONFIG_MAGIC_SYSRQ=n

# ── 기타 ────────────────────────────────────────────────────────
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_AIO=n
CONFIG_IO_URING=n


# ═══════════════════════════════════════════════════════════════
# 2차: 서브시스템 통째로 끄기
#
# CONFIG_MODULES=n 만으로는 부족하다. 모듈이던 옵션 중 상당수를
# olddefconfig 가 빌트인(=y)으로 승격시키기 때문이다 (=m 이 유효하지
# 않으니 기본값으로 되돌아가는데, 그 기본값이 y 인 경우가 많다).
# 실제로 1차에서 =y 가 1,895 -> 2,426 으로 늘었다.
# 그래서 서브시스템 루트 옵션을 직접 꺼야 한다.
# ═══════════════════════════════════════════════════════════════


# ── 이더넷 ─────────────────────────────────────────────────────
# Zero 2 W 에는 이더넷 포트가 없다.
CONFIG_ETHERNET=n
CONFIG_PHYLIB=n

# ── 무선: 우리 칩만 ────────────────────────────────────────────
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN_VENDOR_BROADCOM=y

# 나머지 벤더는 전부 끈다
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_CISCO=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_PURELIFI=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_SILABS=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n

# ── 그래픽 ─────────────────────────────────────────────────────
# DRM(vc4)은 3D 가속용이라 우리에게 필요 없다. 프레임버퍼는 5차에서
CONFIG_DRM=n
CONFIG_BACKLIGHT_CLASS_DEVICE=n
CONFIG_LOGO=n

# ── 입력 장치 / HID ────────────────────────────────────────────
# 키보드를 붙일 때 되돌린다.

# ── 버스: 지금은 안 쓴다 ───────────────────────────────────────
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_MTD=n

# ── 블록 계층 부가 기능 ────────────────────────────────────────
CONFIG_MD=n
CONFIG_BLK_DEV_DRBD=n
CONFIG_STAGING=n
CONFIG_NFC=n


# ── 부팅 로그에서 실제로 확인된 불필요 항목 ────────────────────
# 1차 빌드 로그에 이것들이 전부 올라왔다. 승격된 모듈들이다.
CONFIG_CEPH_LIB=n
CONFIG_BATMAN_ADV=n
CONFIG_OPENVSWITCH=n
CONFIG_VSOCKETS=n
CONFIG_NETCONSOLE=n
CONFIG_NET_9P=n
CONFIG_ATM=n
CONFIG_6LOWPAN=n
CONFIG_IEEE802154=n
CONFIG_MAC802154=n
CONFIG_CAIF=n
CONFIG_RDS=n
CONFIG_HSR=n
CONFIG_NET_DSA=n
CONFIG_AF_KCM=n
CONFIG_SMC=n
CONFIG_XDP_SOCKETS=n
CONFIG_BPF_SYSCALL=n
CONFIG_WIRELESS_HOTKEY=n
CONFIG_SYSTEM_TRUSTED_KEYRING=n
CONFIG_MODULE_SIG=n

# ═══════════════════════════════════════════════════════════════
# 3차: 실제 크기 측정으로 찾아낸 것들
#
# 2차 빌드(20.2MB)의 vmlinux 를 뜯어 남아 있는 큰 덩어리를 확인했다.
# 설정에 명시하지 않아 defconfig 값이 그대로 살아 있던 것들이다.
# ═══════════════════════════════════════════════════════════════

# bcachefs - 신형 파일시스템. 오브젝트만 2.4MB 다.
CONFIG_BCACHEFS_FS=n
CONFIG_FUSE_FS=n

# 보안 모듈 프레임워크. AppArmor 는 크고, 우리 시스템에는 사용자가
# 하나뿐이라 강제접근제어를 쓸 일이 없다.
CONFIG_SECURITY=n
CONFIG_AUDIT=n

# PCI - Zero 2 W 에는 PCI 버스가 없다.
# (defconfig 가 Pi 4 의 PCIe 때문에 켜둔 것)
CONFIG_PCI=n

# SCSI comes back on further down, for USB storage. The MMC block device
# does not go through the SCSI layer, so the card reader pays nothing for
# it. What stays off is the SCSI generic passthrough interface - that is
# for talking raw commands to a device, which nothing here does.
CONFIG_BLK_DEV_BSG=n

# 컨테이너 관련. 우리는 프로세스가 열 개 남짓이고 격리가 필요 없다.
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n

# IPsec / 터널링 - 쓰지 않는다
CONFIG_XFRM_USER=n
CONFIG_INET_ESP=n
CONFIG_INET_AH=n
CONFIG_INET_IPCOMP=n
CONFIG_NET_IPGRE_DEMUX=n
CONFIG_NET_IPGRE=n
CONFIG_NET_IPIP=n

# zstd/lz4 는 쓰지 않는다 (zram 은 아래에서 LZO 를 쓴다)

# ═══════════════════════════════════════════════════════════════
# 4차: select 로 강제되던 것들의 "선택자"를 끈다
#
# 3차 후 조각 134개 중 109개는 반영됐지만 10개가 =y 로 남았다.
# kconfig 의 select 는 사용자 설정을 무시하고 심볼을 강제로 켠다.
# 그래서 대상이 아니라 "그것을 select 하는 쪽"을 꺼야 한다.
# ═══════════════════════════════════════════════════════════════

# CEPH_LIB 를 select 하던 것
CONFIG_BLK_DEV_RBD=n

# ZSTD_COMPRESS / LZ4_COMPRESS 를 select 하던 것들.
# 압축 알고리즘 자체는 initramfs 의 gzip 만 있으면 된다.
CONFIG_CRYPTO_ZSTD=n
CONFIG_CRYPTO_LZ4=n
CONFIG_CRYPTO_LZ4HC=n
CONFIG_CRYPTO_DEFLATE=n
CONFIG_CRYPTO_842=n

# CGROUPS 를 select 하던 것들
CONFIG_CHECKPOINT_RESTORE=n
CONFIG_SCHED_AUTOGROUP=n

# The SCSI upper layers. sd (disks) is switched back on with USB storage
# below; the rest has nothing to drive here - no CD-ROM, no SATA port, no
# storage arriving over the network.
CONFIG_BLK_DEV_SR=n
CONFIG_ATA=n
CONFIG_SCSI_LOWLEVEL=n
CONFIG_ISCSI_TCP=n
CONFIG_SCSI_DH=n

# SCTP
CONFIG_SCTP_COOKIE_HMAC_MD5=n
CONFIG_SCTP_COOKIE_HMAC_SHA1=n

# 디버그 부속
CONFIG_SYSCTL_EXCEPTION_TRACE=n
CONFIG_SYSTEM_DATA_VERIFICATION=n

# These were dragging the SCSI layer in on their own. ATA over Ethernet
# and AppleTalk were both switched on - that is what a general-purpose
# distribution defconfig looks like.
CONFIG_ATA_OVER_ETH=n
CONFIG_ATALK=n
CONFIG_SCSI_ISCSI_ATTRS=n
CONFIG_ISCSI_BOOT_SYSFS=n

# ═══════════════════════════════════════════════════════════════
# 5차: WiFi · SSH · 화면을 위해 다시 켜는 것들
#
# 앞 차수에서 "1단계는 시리얼만"이라며 껐던 것들 중, 이제 실제로
# 필요해진 것을 되살린다.
# ═══════════════════════════════════════════════════════════════

# ── 펌웨어 로더 ────────────────────────────────────────────────
# brcmfmac 이 /lib/firmware/brcm/ 에서 무선칩 펌웨어를 읽어 SDIO 로
# 올린다. 이게 없으면 wlan0 인터페이스 자체가 생기지 않는다.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n

# ── 의사 터미널 ────────────────────────────────────────────────
# SSH 로 들어온 세션은 PTY 위에서 돈다. 없으면 dropbear 가 셸을
# 띄우지 못한다.
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n

# ── 프레임버퍼 콘솔 (HDMI) ─────────────────────────────────────
# DRM(vc4)보다 훨씬 작고, 우리는 3D 가속이 필요 없다.
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y

# ── 무선 데이터 경로 암호 ──────────────────────────────────────
# WPA2 의 4-way 핸드셰이크는 wpa_supplicant(유저스페이스)가 하지만,
# 실제 데이터 암복호(CCMP)는 커널 mac80211 이 한다.
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SHA256=y

# 콘솔 커맨드라인: 시리얼과 화면 양쪽에 뿌린다.
# 마지막 console= 이 /dev/console 이 되므로 tty1(화면)을 뒤에 둔다.
# The order of console= matters, and it is easy to get wrong.
#
# printk goes to every console that is registered, but /dev/console -
# which is what init and the shell write to - maps to the LAST one
# listed. With console=tty1 last, kernel messages still reach the serial
# port while every byte of userspace output disappears into a virtual
# terminal with no screen attached. That looks exactly like a hang right
# after "Run /init as init process".
#
# So ttyAMA0 goes last. tty1 stays ahead of it, which still gets kernel
# messages onto an HDMI screen when one is plugged in.
#
# This only applies when nothing else supplies a command line: on real
# hardware the GPU firmware passes cmdline.txt through the device tree,
# and that wins (CONFIG_CMDLINE_FROM_BOOTLOADER). It is the UEFI path -
# QEMU and UTM booting EFI/BOOT/BOOTAA64.EFI - that falls back to this.
CONFIG_CMDLINE="console=tty1 console=ttyAMA0,115200 rootwait fbcon=font:TER16x32 loglevel=4 rootflags=size=48M"

# ═══════════════════════════════════════════════════════════════
# 6차: zram (RAM 압축 스왑)
#
# 앞에서 CONFIG_SWAP=n 으로 스왑을 아예 껐었다. 이유는 SD 스왑이
# 25MB/s 라 시스템을 멈추게 만들고 카드 수명도 깎기 때문이었다.
# 그 판단 자체는 유효하다 - 우리는 SD 로는 절대 스왑하지 않는다.
#
# 다만 zram 은 성격이 다르다. 스왑 대상을 RAM 안에 두고 압축해서
# 보관한다. SD 에 한 바이트도 쓰지 않고, 보통 3배쯤 압축되므로
# 512MB 를 더 넉넉하게 쓸 수 있다. 안드로이드와 크롬OS 가 저사양
# 기기에서 쓰는 방식이다.
#
# zram 은 스왑 블록장치라서 CONFIG_SWAP 이 필요하다. 켜지만
# 스왑 대상은 zram0 하나뿐이고 SD 파티션을 스왑으로 쓰지 않는다.
# ═══════════════════════════════════════════════════════════════
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# 압축 알고리즘. LZO 는 압축률보다 속도가 좋아 스왑에 적합하다.
# (A53 처럼 느린 CPU 에서는 압축 시간이 곧 지연이 된다)
CONFIG_CRYPTO_LZO=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y

# 메모리 압박 시 커널 동작. guard 가 먼저 개입하지만
# 최후의 보루로 OOM Killer 는 남겨둔다.
CONFIG_MEMCG=n

# ═══════════════════════════════════════════════════════════════
# 7차: USB (이더넷) · virtio
#
# 앞에서 "WiFi 가 SDIO 라 USB 가 필요 없다"며 USB 를 통째로 껐다.
# 유선 연결을 넣기로 하면서 되살린다.
#
# Zero 2 W 에는 이더넷 포트가 없다. micro USB(OTG) 포트로 두 가지를 한다:
#   호스트 모드 - USB 이더넷 어댑터를 꽂는다 (진짜 랜선)
#   가젯 모드   - Pi 가 PC 에게 USB 네트워크 장치로 보인다
#                 케이블 하나로 PC 에서 SSH 가 된다. 공유기도 WiFi 도
#                 필요 없어서 초기 설정에 특히 유용하다.
# ═══════════════════════════════════════════════════════════════
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# Zero 2 W 의 USB 컨트롤러. 호스트/가젯 양쪽을 다 할 수 있다.
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y

# ── 호스트 모드: USB 이더넷 어댑터 ─────────────────────────────
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y        # 표준 CDC. 대부분의 어댑터가 지원한다
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_SMSC95XX=y        # 라즈베리파이 3B 계열에 쓰이던 칩
CONFIG_USB_NET_AX88179_178A=y    # ASIX. 기가비트 어댑터에 흔하다
CONFIG_USB_RTL8152=y             # Realtek. 저가 어댑터에 흔하다

# ── 가젯 모드: Pi 를 USB 네트워크 장치로 ───────────────────────
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_ECM=y               # 리눅스/맥 호스트용
CONFIG_USB_F_RNDIS=y             # 윈도우 호스트용
CONFIG_USB_ETH=y                 # g_ether. 위 둘을 묶어 제공한다
CONFIG_USB_ETH_RNDIS=y

# ── Host mode: USB storage ────────────────────────────────────
# A USB stick, a card reader, an SSD in an enclosure. Three different
# reasons this has to work:
#
#   The board    the Zero 2 W boots from its SD card, but a USB disk is
#                the sane place to keep data - it is faster than the card
#                and it does not wear out from writes the way a cheap
#                card does.
#   UTM          on iOS the drive is often attached over USB rather than
#                VirtIO, and then this is the only way the disk is seen
#                at all.
#   Recovery     plugging the card into another machine is not always an
#                option. A stick is.
#
# A USB disk arrives through the SCSI layer: usb-storage speaks the
# Bulk-Only Transport, hands the commands to the SCSI core, and sd binds
# to what comes out as /dev/sda. So all three have to be on.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# UAS is the faster transport newer enclosures offer. Both QEMU and UTM
# emulate plain Bulk-Only, and on the Zero 2 W the USB 2.0 bus is the
# bottleneck long before the transport is, so it buys nothing here.
# CONFIG_USB_UAS is not set

# Host controllers. DWC2 above is the board's own. A virtual machine has
# a PCI one instead, and which one depends on what the user picked:
# UTM's "USB 3.0" and QEMU's qemu-xhci are XHCI, "USB 2.0" is EHCI.
# Both are cheap, and having only one of them means the disk silently
# does not appear.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y

# The Renesas controllers need a firmware blob uploaded before they run.
# That is a PCIe card in a desktop, not anything we will meet.
# CONFIG_USB_XHCI_PCI_RENESAS is not set

# ── PCI (가상머신용) ──────────────────────────────────────────
# Pi Zero 2 W 에는 PCI 가 없다. 그런데 이걸 켜야 UTM 과 QEMU 에서
# 같은 커널이 돈다.
#
# QEMU 의 virt 머신과 UTM 은 기본으로 virtio 장치를 PCI 에 붙인다
# (virtio-blk-pci). PCI 가 없으면 커널이 디스크를 아예 못 봐서
# /data 가 안 붙고 파이썬도 없는 상태로 셸만 뜬다. QEMU 에서는
# -device virtio-blk-device 로 MMIO 를 강제할 수 있지만 UTM 에는
# 그런 설정이 없다.
#
# 실기에서는 PCI 버스가 없으니 이 코드는 스캔만 하고 끝난다.
# ── ACPI (virtual machines) ───────────────────────────────────
# The Pi has no ACPI - it is described entirely by its device tree.
# But QEMU's virt machine and UTM default to ACPI, and their UEFI
# firmware then hands the kernel ACPI tables and no device tree. Without
# ACPI support the kernel boots and finds no hardware at all: no serial,
# no disk, no network. The symptom is a boot that stops dead right after
# "EFI stub: Exiting boot services".
#
# SPCR is what tells us which serial port is the console in that case.
CONFIG_ACPI=y
CONFIG_ACPI_SPCR_TABLE=y
CONFIG_ACPI_MCFG=y

# ── Display ───────────────────────────────────────────────────
# Two very different paths end up at the same text console.
#
#   The board      the GPU firmware sets up a framebuffer for HDMI and
#                  drives that. No 3D, no KMS - we only want text.
#   A VM window    UTM and QEMU put a virtio-gpu on the PCI bus. That
#                  needs the DRM stack; without it the window stays black
#                  no matter what the firmware did.
#
# DRM_FBDEV_EMULATION is what makes a DRM driver produce the /dev/fb0
# that fbcon draws the console on. Without it we would have a working
# GPU driver and still no visible text.
#
# This costs about 2MB. It is the price of seeing a shell on a screen.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_GEM_SHMEM_HELPER=y

#
# The comment above says "no KMS - we only want text", and that was true
# while text was all this could do. It stopped being true when the amd64
# build got a real graphics stack: anything that draws - X11, Wayland, a
# toolkit - opens /dev/dri and talks KMS, and the firmware framebuffer
# virtual machine and not on the hardware this system was written for,
# which is the wrong way round.
#
# a compositor does not need it to put a window on the screen, and the
# Zero 2 W is not the board anyone renders on.

# A console font you can read across a room.
#
# The 8x16 default gives 240x67 characters on a 1080p TV, which is
# unreadable from a sofa, and squints on a phone screen in UTM.
# Terminus 16x32 gives 120x33 instead. fbcon picks it by name from the
# kernel command line.
CONFIG_FONT_TER16x32=y

# ── Framebuffer handed over by UEFI ───────────────────────────
# UTM and other UEFI hosts set up a display before handing over to the
# kernel, and pass its address in the EFI system table. Without FB_EFI
# the kernel ignores that and the VM window stays black - you would have
# to switch the VM to serial console mode to see anything.
#
# We have no DRM and no virtio-gpu driver, so this handover is the only
# way a graphical VM shows the console. It costs about 10KB.
#
# On the Pi none of this runs: there the GPU firmware sets up the
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB_EFI=y

CONFIG_PCI=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_HOST_GENERIC=y        # QEMU virt / UTM 의 ECAM 방식 브리지
CONFIG_PCI_ECAM=y

# ── virtio (가상머신) ─────────────────────────────────────────
# 실기에는 없지만 이게 있어야 QEMU/UTM 에서 저장장치와 네트워크까지
# 검증할 수 있다. 없으면 부팅과 셸까지밖에 확인하지 못한다.
# MMIO 와 PCI 두 방식을 다 넣는다 - 호스트마다 붙이는 방식이 다르다.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y


# ── Build for size, not for speed ─────────────────────────────
# The kernel is stored uncompressed, so every byte is a byte the board
# reads off the SD card before anything runs. At roughly 20MB/s that is
# real boot time, and -Os took 24.4MB down to 22.0MB.
#
# The usual argument against -Os is slower code, but this kernel spends
# its life waiting on a shell, a socket and an SD card, not in tight
# loops - and reading 2.4MB less costs about 0.12s less at boot.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# wpa_supplicant, CPython and MicroPython are all aarch64. Carrying the
# compat syscall layer for binaries that do not exist is pure weight.
# (Turning this back on is the fix if a 32-bit Pi binary is ever needed.)
# CONFIG_COMPAT is not set

# Symbol names for every symbol, not just the exported ones. Useful in an
# oops trace, and we keep plain KALLSYMS for that, but the "all" variant
# is a debugging luxury.
# CONFIG_KALLSYMS_ALL is not set


# ═══ Server essentials ═══════════════════════════════════════════
#
# Things every other distribution has on day one and we did not.

# ── IPv6 ──
# Not optional any more: mobile networks and many ISPs hand out IPv6
# only, and a device that speaks IPv4 alone silently fails to reach
# half the internet. The stack costs a few hundred KB.
CONFIG_IPV6=y
# CONFIG_IPV6_SIT is not set   # turned off further down

# ── Firewall ──
# A board on the open internet with no packet filter is one open port
# away from trouble. This is the netfilter core plus the pieces a
# simple "allow SSH and established, drop the rest" policy needs.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NETFILTER_NETLINK=y

# ── SPI ──
# The bus e-ink panels, ADCs and most sensor breakouts speak. Without
# it the kernel does not even know an SPI device exists, so a display
# plugged into the header is invisible.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_SPIDEV=y

# I2C goes with it - the other half of the sensor world, and how a
# battery-backed clock module (DS3231) would attach.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y

# ═══ Weight that was never used ══════════════════════════════════
# A simulated WiFi radio for testing mac80211, and a fake GPIO chip
# for testing gpiolib. Both are test scaffolding for kernel
# developers. On a real board they do nothing but take up space.
# CONFIG_MAC80211_HWSIM is not set
# CONFIG_GPIO_MOCKUP is not set

# CONFIG_DEBUG_KERNEL cannot be turned off here: EXPERT selects it, and
# we need EXPERT to disable base features at all. It is only a menu gate
# though - the weight is in the individual options below.


# A watchdog QEMU can provide, so the reboot-on-hang path is testable
# somewhere other than the board itself. About 8KB. On the Pi it is
CONFIG_I6300ESB_WDT=y

# ═══ Cutting what this board will never run ══════════════════════
#
# Measured, not guessed: each of these was actually compiled into the
# kernel we were shipping.

# Datacenter networking. A load balancer, overlay tunnels, link
# aggregation across several NICs, a cluster lock manager. This board
# has one WiFi radio.
# CONFIG_IP_VS is not set
# CONFIG_IP_SET is not set
# CONFIG_VXLAN is not set
# CONFIG_MACVLAN is not set
# CONFIG_BONDING is not set
# CONFIG_VETH is not set
# CONFIG_DLM is not set

# Protocols nothing here speaks. SCTP is telecom signalling; MPTCP
# splits a connection across several links, and we have one.
# CONFIG_IP_SCTP is not set
# CONFIG_MPTCP is not set

# The legacy iptables machinery. We use nftables, which replaced it.
# CONFIG_NETFILTER_XTABLES is not set

# A CIFS/SMB *server* was being built into the kernel. Also filesystems
# nothing will ever mount: ReiserFS was removed from Linux upstream,
# SquashFS is for read-only images, eCryptfs is deprecated, and
# overlayfs is for containers.
# CONFIG_SMB_SERVER is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_ECRYPT_FS is not set
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y

# Infrared remote control receivers.
# CONFIG_RC_CORE is not set
# CONFIG_MEDIA_SUPPORT is not set

# Drivers for specific game controllers and tablets. HID_GENERIC
# handles an ordinary USB keyboard, which is all we need on a screen.
# CONFIG_HID_WACOM is not set
# CONFIG_HID_LOGITECH is not set
# CONFIG_HID_WIIMOTE is not set
# CONFIG_HID_SONY is not set
# CONFIG_HID_APPLE is not set
# CONFIG_HID_DEBUG is not set

# USB-to-serial adapters (FTDI cables, 3G modems). The board's own
# serial console is on the header pins and needs none of this.
# CONFIG_USB_SERIAL is not set

# The 3D engine and DSI panel drivers. We drive a text console on a
# framebuffer - there is no 3D and no ribbon-cable panel.
# CONFIG_DRM_PANEL_SIMPLE is not set

# Debugging surfaces. Verbose BUG() output stays (it is what makes a
# crash readable); the rest is for someone bringing up a board.
# CONFIG_DEBUG_MISC is not set
# CONFIG_MAGIC_SYSRQ is not set

# ═══════════════════════════════════════════════════════════════
# Recovering on its own
#
# This board sits on a shelf with no keyboard and no screen. Anything
# that needs a person standing next to it is, in practice, a board that
# stays broken until someone notices.
# ═══════════════════════════════════════════════════════════════

# A kernel panic stops dead by default and waits forever. That is right
# for a developer reading the backtrace off a serial cable and wrong for
# everything else: the message has already gone to the serial console
# either way, and after ten seconds a reboot is strictly better than a
# board that is simply gone. The hardware watchdog covers the case where
# the kernel is too far gone to even reach this code.
CONFIG_PANIC_TIMEOUT=10

# A task stuck in an uninterruptible wait for two minutes is a bug -
# usually storage that stopped answering. This prints it with a
# backtrace, which logd then keeps on the data partition, so the reason
# survives the reboot that follows.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
# Report it. Do not panic over it - the process is stuck, not the kernel.
# CONFIG_BOOTPARAM_HUNG_TASK_PANIC is not set

# The thermal framework: it reads the SoC sensor and clocks the CPU down
# as it heats up. This is the layer under guard - guard holds the CPU at
# its lowest speed as a policy, while this is the kernel's own reflex,
# and the firmware's hard limit sits under both.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y

# Frequency scaling. Idle cores drop to 600MHz instead of sitting at
# 1GHz, which is both the power saving and the headroom that keeps the
# chip away from its thermal limit in the first place. ondemand is also
# what guard puts back after it has held the CPU down.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y

# ═══════════════════════════════════════════════════════════════
# Network drivers for hardware that is not here
#
# ifconfig listed yam0 through yam3 and bcsf0 on a board with one WiFi
# chip. They are amateur radio packet modems - drivers for kit that
# attaches to a serial port and has not been sold for twenty years. The
# defconfig carries them because it is written for every Raspberry Pi
# anyone might own, running anything.
#
# The cost is not only the space. Every one of them registers an
# interface, so anyone looking at this machine's network has to work out
# which five of the ten listed are real.
# ═══════════════════════════════════════════════════════════════

# Amateur radio: AX.25 and everything selected by it.
# CONFIG_HAMRADIO is not set
# CONFIG_AX25 is not set
# CONFIG_NETROM is not set
# CONFIG_ROSE is not set
# CONFIG_MKISS is not set
# CONFIG_BPQETHER is not set
# CONFIG_BAYCOM_SER_FDX is not set
# CONFIG_BAYCOM_SER_HDX is not set
# CONFIG_YAM is not set

# A loopback that is not lo, for testing routing setups we do not have.
# CONFIG_DUMMY is not set

# Traffic shaping on the way in, which needs a shaper to be configured
# for it and there is none.
# CONFIG_IFB is not set

# IP over a serial line. The serial port here is the console; putting a
# network on it would take away the one way in when everything else is
# broken.
# CONFIG_SLIP is not set

# WireGuard. A good VPN, and 40KB of one nothing on this board is asked
# to do. It comes back the moment there is a reason.
# CONFIG_WIREGUARD is not set

# Tunnel devices. Four more interfaces in every listing, for carrying one
# protocol inside another:
#   ip_vti0, ip6_vti0   IPsec tunnels, and IPsec is already off
#   sit0                IPv6 over IPv4, for reaching IPv6 from a network
#                       that has none. A router either offers IPv6 or it
#                       does not; this board is not going to tunnel its
#                       way to it.
#   ip6tnl0             IPv6 inside IPv6
# IPv6 itself stays on. This is the tunnelling, not the protocol.
# CONFIG_NET_IPVTI is not set
# CONFIG_IPV6_VTI is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_IPV6_TUNNEL is not set

# ═══════════════════════════════════════════════════════════════
# Weight, and one thing that should not have been on at all
# ═══════════════════════════════════════════════════════════════

# The kernel debugger, reachable over the serial console.
#
# This is not only weight. KGDB on the console means anyone who can
# reach the serial pins - or a serial console left connected - can stop
# the kernel and read or write any memory in the machine. On a board
# whose whole access control is one SSH key, that is a second door with
# no lock on it.
#
# It also selects KALLSYMS_ALL, which is the full symbol table: names
# that exist so a debugger can print them.
# CONFIG_KGDB is not set
# CONFIG_KGDB_SERIAL_CONSOLE is not set
# CONFIG_KGDB_KDB is not set
# CONFIG_KALLSYMS_ALL is not set

# Pin controllers for the Raspberry Pi 5. Different silicon entirely -
# RP1 is the south bridge on a board this one will never be.
# CONFIG_PINCTRL_RP1 is not set
# CONFIG_PINCTRL_BCM2712 is not set

# A random number generator inside a TPM chip. There is no TPM here, and
# the SoC has its own hardware RNG which is already on.
# CONFIG_HW_RANDOM_TPM is not set

# GPIO described through ACPI tables. ACPI is on for virtual machines,
# but a VM does not have GPIO pins and the board describes its own
# through the device tree.
# CONFIG_GPIO_ACPI is not set

# Display panel drivers - fourteen of them, for specific LCD modules
# that attach to the DSI ribbon connector. We drive a text console on
# whatever framebuffer HDMI or the VM gives us; none of these is that.
# CONFIG_DRM_PANEL_LVDS is not set
# CONFIG_DRM_PANEL_ILITEK_IL79600A is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9806E is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9806E_SPI is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9881C is not set
# CONFIG_DRM_PANEL_JDI_LT070ME05000 is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7701 is not set
# CONFIG_DRM_PANEL_TPO_Y17P is not set
# CONFIG_DRM_PANEL_WAVESHARE_TOUCHSCREEN is not set
# CONFIG_DRM_PANEL_WAVESHARE_TOUCHSCREEN_V2 is not set

# ── A compressed kernel for the EFI path ──────────────────────
#
# wrapped in a small stub that decompresses it. Roughly half the size.
#
# It cannot replace the plain Image. Decompression happens through EFI
# boot services, and the Raspberry Pi's GPU firmware provides none - it
# loads the file named by kernel= and jumps to it. So the board keeps
# Image and the UEFI path takes vmlinuz.efi. One build, two outputs,
# and the virtual machine image gets to be half the size.
CONFIG_KERNEL_GZIP=y

# LATENCYTOP - a measuring tool for scheduler latency, and the reason
# the full symbol table kept coming back.
#
# It selects KALLSYMS_ALL, which puts the name of every symbol in the
# kernel - not just the functions - into the image, permanently in RAM.
# That is a megabyte spent so that a tool nobody here runs could print
# nicer stack traces. Plain KALLSYMS stays on, which is what an oops
# needs.
# CONFIG_LATENCYTOP is not set

# ── 'ps' 가 보여준 것들 ─────────────────────────────────────────
#
# 부팅한 기계에서 ps 를 돌려보고 나서 지운 것들이다. 커널 스레드가
# 눈에 보이면 무엇이 켜져 있는지가 설정 파일을 읽는 것보다 정직하게
# 드러난다. 아래 넷은 전부 이 보드에서 쓸 일이 없고, 앞의 셋은
# 공격 표면이기도 하다.

# 네트워크 블록 장치. 원격 서버의 디스크를 로컬 디스크처럼 붙인다.
# 헤드리스 SSH 보드에서 이것이 켜져 있을 이유가 없고, 켜져 있으면
# 커널이 네트워크에서 온 블록 요청을 처리하는 코드를 안고 있게 된다.
# nbd0~nbd15 의 커널 스레드 16개도 함께 사라진다.
# CONFIG_BLK_DEV_NBD is not set

# USB over IP. USB 장치를 네트워크 너머로 붙이는 프로토콜이다.
# 호스트 쪽(USBIP_HOST)은 이 보드의 USB 장치를 남에게 내주는 기능이다.
# CONFIG_USBIP_CORE is not set
# CONFIG_USBIP_VHCI_HCD is not set
# CONFIG_USBIP_HOST is not set
# CONFIG_USBIP_VUDC is not set

# 패킷 생성기. 커널 안에 들어 있는 트래픽 발생 도구다. 성능 시험용이고,
# 이 보드에서는 쓸 일이 없다.
# CONFIG_NET_PKTGEN is not set

# 화면 낭독기. 화면이 없는 기계에서는 아무 일도 하지 않는다.
# CONFIG_SPEAKUP is not set
# CONFIG_SPEAKUP_SYNTH_SOFT is not set

# USB 마우스·터치스크린 HID 드라이버. 이 보드에 붙을 일이 없다.
# CONFIG_HID_ELO is not set
# CONFIG_HID_MAGICMOUSE is not set
# CONFIG_USB_IDMOUSE is not set

# ── The one USB device controller ──────────────────────────────
# g_zero is a test gadget: it answers as a device that does nothing,
# for exercising a UDC driver. It is not useful here, and on a board
# with exactly one controller it is worse than useless - in
# drivers/usb/gadget/legacy/Makefile g_zero.o links before g_ether.o,
# so it claims the UDC first and the ethernet gadget never binds. The
# boot log says "UDC core: g_ether: couldn't find an available UDC"
# and the USB network link, which is the way into a board whose WiFi
# is misbehaving, is simply not there.
CONFIG_USB_ZERO=n

# ── The console font ───────────────────────────────────────────
# CONFIG_FONTS is the "choose which fonts to build" menu. Without it
# only the default 8x16 is compiled in, and fbcon quietly falls back to
# it - so cmdline.txt asking for font:TER16x32 did nothing at all, and
# nothing said so. On a 1080p screen 8x16 is about two millimetres tall.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_FONT_8x16=y

# ── WiFi power save: off, in the kernel ─────────────────────────────
#
# This is the one that costs you the network.
#
# CONFIG_CFG80211_DEFAULT_PS=y comes in from the Raspberry Pi defconfig
# and means cfg80211 turns power save on for every wireless interface as
# it is created. On a BCM43430 the chip then sleeps between beacons -
# and the AP sends EAPOL 1/4, the first frame of the WPA2 handshake,
# immediately after association, to a station that is asleep.
#
# What that looks like from outside is exactly what the board did:
#
#     wlan0: Associated with 5a:86:94:4c:53:94
#     wlan0: Authentication with 5a:86:94:4c:53:94 timed out.
#     wlan0: Added BSSID into ignore list
#
# with 33 packets received (beacons, which arrive at TIM boundaries and
# wake it) and not one EAPOL frame. It reads like a wrong passphrase and
# is not: a wrong key gets you 4-Way Handshake failed, because the
# frames arrive and the maths fails. Here nothing arrives at all.
#
# There was already a defence against this - `net powersave off wlan0`
# in /etc/rc - and it is still there. But it is a userspace command
# speaking generic netlink that has never once been shown to work on a
# board, because qemu-user permits only NETLINK_ROUTE and there was no
# other way to run it. Depending on it was the mistake. Turned off in
# the kernel, the chip never enables power save in the first place, on
# the very first association, with nothing having to run correctly
# first.
#
# The cost is idle current: a few tens of milliamps on a board that is
# mains-powered and whose entire purpose is answering the network.
CONFIG_CFG80211_DEFAULT_PS=n

# ── The regulatory database ─────────────────────────────────────────
#
# The boot log says, on every boot:
#
#     platform regulatory.0: Direct firmware load for regulatory.db
#                            failed with error -2
#     cfg80211: failed to load regulatory.db
#
# and it is right - the file was never put on the image. Without it
# cfg80211 falls back to the world domain, which is the most
# conservative set of rules there is: reduced power, and several
# channels marked no-IR, meaning the station may not transmit on them
# until it has heard a beacon. A marginal link on a board sitting next
# to its router is what that looks like.
#
# The file itself is data, not code - it is fetched by
# tools/fetch-wifi-fw.sh with its signature (regulatory.db.p7s), which
# the kernel checks against the certificates it says it loaded on the
# line above.

# ══ amd64 answers, last so they win ═══════════════════════════
# lp-zero-amd64.fragment - what an ordinary PC needs that a Pi does not.
#
# This is the only file to edit for the amd64 kernel. It is merged LAST,
# after the arm64 answers, so everything here wins without a list of
# exceptions to keep in step. Maintaining that list by hand went wrong
# three times - no console, no graphics, no sound - each time because a
# line that is right for a Raspberry Pi was read after the line that was
# right here.
#
# One case "last wins" does not cover: a choice (compression, -O2 or
# -Os, the default governor) where the Pi picked a different member.
# Kconfig then takes this file's member, but the Pi's "=y" for the other
# one is still the last word on THAT symbol, and kernel/build.sh's check
# reports it as not applied on every build. So where this file picks a
# different member, it also says =n to the Pi's.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_MICROCODE=y
CONFIG_X86_MCE=y
CONFIG_ACPI=y
CONFIG_PM=y

# ── boot ──
# One bzImage with the EFI stub inside it, so "copy it to EFI/BOOT" is
# the whole story on a PC and in a VM alike. tty0 first and ttyS0 last:
# printk goes to every console listed, but /dev/console - where init
# puts the login shell - is the last one, and a VM run headless has no
# screen to put it on.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_RELOCATABLE=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 console=ttyS0,115200"

# ── console ──
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# ── storage ──
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
# virtio-scsi and Hyper-V storage are "low-level" SCSI drivers, and the
# Pi config switches that whole menu off - so these two lines were in
# this file and not in the kernel, which the build's own check said on
# every build. The menu's other drivers all default to off.
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y

# ── the clock ──
# A PC and an EC2 instance both have a battery-backed clock that keeps
# running while the machine is off. The kernel had the driver but not
# RTC_HCTOSYS, which is the part that actually reads it at boot - so the
# clock started at 1970 every time and the only thing standing between
# that and a working HTTPS handshake was the timestamp we saved at the
# last shutdown. That number does not advance while the power is off, so
# a machine switched on a week later thought a week had not passed.
#
# SYSTOHC writes the other way, but only for a kernel that believes its
# clock is synchronised; `date -s`, `ntp` and `hwclock -w` write the RTC
# themselves rather than hoping.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_CMOS=y

# ── Amazon EC2 ──
# Nitro instances (everything from m5/c5 on) present their network card
# as ENA and their disk as NVMe. Without the ENA driver the instance
# boots, finds no network device at all, and there is no way in to see
# why - the console shows a system that came up perfectly and cannot be
# reached. DIMLIB is ENA's adaptive interrupt moderation and the build
# fails without it.
#
# The older Xen generations (t2, m4) are still rented out and use
# netfront/blkfront instead, so both are here.
# CONFIG_ETHERNET has to be turned back on here. The arm64 config sets
# it to n on purpose - a Pi Zero 2 W has no ethernet port, only WiFi -
# and this file is that config plus this fragment, so without this line
# the whole drivers/net/ethernet menu is skipped and every driver below
# is silently dropped. That is not a theory: the image built before this
# had CONFIG_E1000, CONFIG_R8169 and CONFIG_ENA_ETHERNET written in this
# very file and none of them in the built kernel. On a real PC it had no
# network card at all, and on EC2 it had no way in.
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_ENA_ETHERNET=y
CONFIG_DIMLIB=y
CONFIG_XEN=y
CONFIG_XEN_PV=y
CONFIG_XEN_PVHVM=y
CONFIG_XEN_BLKDEV_FRONTEND=y
CONFIG_XEN_NETDEV_FRONTEND=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y

# ── virtual machines ──
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VMWARE_VMCI=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y

# ── network ──
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_8139CP=y
CONFIG_IGB=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y

# ── USB ──
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y

# ── randomness ──
# getrandom() feeds the update signature check and the DNS resolver.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_HW_RANDOM_INTEL=y
CONFIG_RANDOM_TRUST_CPU=y

# ── graphics ──
#
# DRM is on, and it has to be: anything that draws - X11, Wayland, a
# toolkit - opens /dev/dri, not a framebuffer. Without it this machine
# has a text console and no UI package can ever work on top of it.
#
# It was off for two commits because of a build failure I took the cheap
# way out of. backlight_set_display_name() is defined inside #ifdef
# CONFIG_OF in drivers/video/backlight/backlight.c but declared in the
# header under CONFIG_BACKLIGHT_CLASS_DEVICE alone, so on a machine with
# no device tree - every PC - DRM's panel bridge calls a function nobody
# compiled, and vmlinux fails to link naming neither option. Turning DRM
# off made the error go away and took the graphics with it.
#
# The fix is one line. CONFIG_OF is selectable on x86 for this kind of
# reason, it costs a few kilobytes that never run where no device tree
# is passed, and the symbol exists again.
CONFIG_OF=y
CONFIG_DRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y

# simpledrm is the one that matters most: it drives the EFI framebuffer
# on hardware we have no specific driver for, which is the case that
# must not be a black screen. Then the VM drivers, then Intel, which is
# most real laptops.
#
# amdgpu is deliberately absent: it is larger than this whole kernel and
# needs firmware blobs that are not here, so it would add megabytes to
# every download for a card that still would not light up. nouveau is
# in, further down, for a different reason than drawing - see the XPS
# section.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_QXL=y
CONFIG_DRM_I915=y

CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# ── what a UI needs besides pixels ──
#
# X11 has used SysV shared memory for local clients since the 1980s and
# still does; without it every image goes over the socket instead, if it
# starts at all. Wayland compositors want a real tmpfs for their buffers.
CONFIG_SYSVIPC=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SHMEM=y
#
# Flatpak (the Software app's Flathub applications) runs every program
# in a bubblewrap sandbox, and Debian's bubblewrap is not setuid: it
# builds the sandbox in an unprivileged user namespace. The document
# portal - how a sandboxed program gets the one file somebody picked in
# the file chooser - is a FUSE filesystem. The Pi's config turns FUSE
# off to save space; a desktop cannot do without either.
CONFIG_USER_NS=y
CONFIG_FUSE_FS=y

# ── input ──
# A keyboard and a pointer from all three places they arrive: the PS/2
# controller a VM emulates, USB, and the absolute pointer QEMU and
# VMware use so the mouse is not trapped inside the window.
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y

# ── sound ──
# A desktop with no audio device is a bug report waiting to happen. HDA
# covers real machines and QEMU's intel-hda; virtio-snd covers the rest.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_VIRTIO=y
CONFIG_SND_USB_AUDIO=y

# ═══════════════════════════════════════════════════════════════════
# The machine this is for: Dell XPS 15 9550
#
# i7-6700HQ (Skylake), HD 530 + GTX 960M (Optimus, no mux), 3840x2160
# touch panel, NVMe, QCA6174 or BCM4350 WiFi, ALC3266, I2C-HID touchpad,
# Thunderbolt 3, Realtek SD reader. Everything below is built in: this
# kernel has no modules (CONFIG_MODULES=n comes from the Pi config) and
# the image ships neither /lib/modules nor a module loader, so a driver
# that is =m here is a driver that does not exist.
#
# Built in has one consequence that matters more than any single option:
# every driver below probes before the root filesystem is mounted, so a
# driver that asks for firmware at probe time asks the initramfs, not
# the disk. kernel/build.sh puts the firmware tools/fetch-pc-fw.sh
# fetched into the disk kernel's initramfs for exactly that reason - see
# the comment there.
# ═══════════════════════════════════════════════════════════════════

# ── display ──
# i915 drives the panel. Its DMC firmware (i915/skl_dmc_ver1_27.bin) is
# what lets the display engine reach DC5/DC6; when it fails to load,
# i915 says "Disabling runtime power management" and holds the display
# power well on for as long as the machine is up. GuC and HuC are not
# requested on Skylake by default (enable_guc is 0 before Gen12); their
# blobs sit beside the DMC one anyway, so that i915.enable_guc=2 - HuC,
# which only VA-API encoding uses, and a parameter i915 marks unsafe and
# taints the kernel for - finds them at probe time instead of failing
# (tools/fetch-pc-fw.sh). PSR and FBC are runtime defaults on
# Gen9 (enable_psr=-1, enable_fbc=-1), not config options; the panel
# backlight is i915's own intel_backlight, picked over acpi_video0 by
# the kernel's native-backlight rule for Windows 8 era firmware.
CONFIG_DRM_I915=y
CONFIG_ACPI_VIDEO=y

# nouveau is here to switch the GTX 960M OFF, not to draw with it.
#
# The panel is wired to the Intel GPU; the NVIDIA one has no outputs. A
# PCI device with no driver bound stays in D0 and the laptop pays for it
# in watts all day. nouveau, with runtime PM (nouveau.runpm=-1 means "on
# for Optimus laptops", which is this one), lets the GPU autosuspend
# after five seconds unused; the PCIe root port above it then drops into
# D3cold through the _PR3 power resources in the firmware, which is how
# a Skylake Optimus laptop actually cuts the power. nouveau_acpi.c sees
# _PR3 and skips the older Optimus _DSM power-off, and nouveau already
# carries the quirk for this exact root port (8086:1901) that avoids the
# lockup on resume. GM107 needs no signed firmware, so there is no blob.
#
# VGA_SWITCHEROO is how nouveau learns it is the discrete half of an
# Optimus pair (nouveau_is_optimus), and so whether runtime PM is on.
CONFIG_DRM_NOUVEAU=y
CONFIG_VGA_SWITCHEROO=y
CONFIG_PCIEPORTBUS=y

# The boot console on a 3840x2160 15.6" panel. The 8x16 font is a
# quarter of a millimetre per pixel row there, which nobody can read;
# fbcon=font:TER16x32 on the disk image's command line picks this one.
# 8x16 stays for small screens and virtual machines.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# ── booting without a flicker ──
# From power button to desktop the screen should change twice: the
# firmware's logo, then the desktop. Every other change - black, a
# console, a mode set - reads as a stutter before anything has moved.
#
# The picture is handed along rather than redrawn. simpledrm (above)
# takes over the framebuffer the firmware left lit and does not clear
# it. i915 then removes simpledrm and reads back the mode the GOP set
# up - on 6.12 that "fastboot" is how every platform works, and the
# i915.fastboot parameter no longer exists - so when the panel is
# already at its native mode it is taken over without a mode set, and
# the first flip is the compositor's. The DMC firmware it asks for on
# the way is in this kernel's initramfs (kernel/build.sh), so that
# request is answered from memory instead of failing.
#
# What remains is fbcon, which would clear the screen and draw a text
# console the moment the first framebuffer appears. Deferred takeover
# keeps the dummy console until something is actually written to the
# screen; with quiet loglevel=3 on the command line the kernel writes
# nothing there below a critical message, so a panic still takes the
# screen over and is readable, and so does a rescue shell on tty1. The penguin logo would be drawn by exactly that takeover,
# so it stays off: the logo the owner sees is the firmware's, then ours
# from the desktop.
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_LOGO=n

# ── touch screen and touchpad ──
# Both are HID devices behind the chipset's LPSS I2C controllers (the
# touch screen may instead be on USB, which HID_MULTITOUCH covers too).
#
# PINCTRL_SUNRISEPOINT is the one that is easy to miss and fatal to
# miss: the I2C-HID interrupt lines are GPIOs on the Sunrisepoint PCH,
# described in ACPI as GpioInt. Without the pin controller there is no
# GPIO chip for GPIO_ACPI to resolve them against, i2c-hid gets no IRQ,
# and touch and touchpad are both dead with nothing in the log that says
# why. GPIO_ACPI has no prompt - it follows GPIOLIB - but it is listed so
# the build's own check shows it.
CONFIG_PINCTRL=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ACPI=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_WACOM=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y

# ── storage ──
# NVMe and ext4 are what reach the root, so they are built in by the
# fragment's first half already. The SD slot is a Realtek RTS525A on
# PCIe; UAS is what a USB 3 SSD enclosure speaks.
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_HWMON=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_MISC_RTSX_PCI=y
CONFIG_MMC_REALTEK_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ── audio ──
# ALC3266 is Dell's name for an ALC298; the Realtek codec driver carries
# the XPS fixups. HDMI audio goes through i915 (SND_HDA_I915, selected by
# DRM_I915). Power save 1 lets the codec sleep after a second of silence.
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=1

# ── WiFi and Bluetooth ──
# Two cards were sold in this machine: Killer 1535 (QCA6174, ath10k) and
# Dell DW1830 (BCM4350, brcmfmac over PCIe). Both are here. Their
# firmware - and the regulatory database, which built-in cfg80211 asks
# for once at boot and then never again - comes from fetch-pc-fw.sh.
#
# Bluetooth rides on USB for both cards. btusb loads the QCA rampatch
# itself (qca/rampatch_usb_00000302.bin); BT_QCA is the UART-attached
# QCA driver's helper and has no part in that. BT_BCM is the Broadcom
# patchram helper; linux-firmware carries no patch for the BCM4350's
# Bluetooth half, which then runs on its ROM firmware.
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_SDIO=n
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_BCM=y
CONFIG_BT_DEBUGFS=n
CONFIG_RFKILL=y

# ── the laptop around it ──
# Battery, charger, lid, power button, thermal zones; Dell's platform
# drivers for the hotkeys, the keyboard backlight (dell::kbd_backlight,
# a LEDS_CLASS device) and the fan and temperature sensors of the SMM
# interface; intel-hid for the power button while in s2idle; dell-rbtn
# for the airplane-mode key.
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_WMI=y
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DCDBAS=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_SMBIOS_SMM=y
CONFIG_DELL_LAPTOP=y
CONFIG_DELL_WMI=y
CONFIG_DELL_RBTN=y
CONFIG_INTEL_HID_EVENT=y
CONFIG_INTEL_VBTN=y
# Dell's other platform drivers default to m, and with no modules "m"
# becomes "y". These are for other Dells (all-in-ones, Alienware,
# Latitude LEDs, 2020s battery and thermal-profile interfaces, the HDD
# free-fall sensor) or are BIOS-update and BIOS-settings interfaces this
# image has no tool for; DELL_RBU also drags in the firmware loader's
# user-helper fallback, which nothing else here wants.
CONFIG_DELL_RBU=n
CONFIG_DELL_WMI_SYSMAN=n
CONFIG_DELL_WMI_AIO=n
CONFIG_DELL_WMI_DDV=n
CONFIG_DELL_WMI_LED=n
CONFIG_DELL_PC=n
CONFIG_DELL_SMO8800=n
CONFIG_ALIENWARE_WMI=n
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_HWMON=y
CONFIG_SENSORS_DELL_SMM=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y

# Power: the PMC driver (SLP_S0 residency, what tells s2idle from real
# sleep), intel_pstate with HWP, intel_idle for the C-states the ACPI
# tables do not describe, RAPL for package power readings, and the
# package temperature sensor.
CONFIG_INTEL_VSEC=y
CONFIG_INTEL_PMT_TELEMETRY=y
CONFIG_INTEL_PMC_CORE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=y
CONFIG_THERMAL=y
CONFIG_X86_PKG_TEMP_THERMAL=y
# What thermald works through: the ACPI DPTF participants (INT3400,
# INT3403), idle injection when the package runs hot, and the PCH's own
# sensor.
CONFIG_INT340X_THERMAL=y
CONFIG_ACPI_THERMAL_REL=y
CONFIG_INTEL_POWERCLAMP=y
CONFIG_INTEL_PCH_THERMAL=y

# Suspend. SUSPEND gives both s2idle and deep (S3) in /sys/power/
# mem_sleep. The command line asks for deep (tools/mkdisk.sh): the XPS
# 9550 sleeps and wakes properly in S3 (Ubuntu uses it there), and its
# s2idle keeps drawing power. A machine without S3 keeps s2idle.
# Hibernation stays off - there is no swap partition to write to.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y

# Thunderbolt 3 (Alpine Ridge) and USB-C. PCIe hotplug is how a
# Thunderbolt device's PCIe tunnel appears; the WMI switch forces the
# controller's power on, which the firmware otherwise cuts when nothing
# is plugged in.
CONFIG_USB4=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_INTEL_WMI_THUNDERBOLT=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y

# The webcam is a USB Video Class device. The media filter keeps the
# rest of drivers/media - TV tuners, radio, remote controls - out.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_GSPCA=n
CONFIG_RC_CORE=n

# UEFI: the kernel is its own EFI application, and efivarfs is how
# userspace reads and sets boot entries (and how preinit reads which
# entry the firmware started).
#
# The boot menu on the ESP (\EFI\LP\lpboot.efi) starts this kernel the
# way the UEFI shell does: LoadImage + StartImage on \EFI\LP\vmlinuz.efi,
# with load options such as "initrd=\EFI\LP\initrd.img root=... ". The
# stub takes the initrd two ways and 6.12 has no switch for either:
# through the LoadFile2 protocol on the LINUX_EFI_INITRD_MEDIA_GUID
# device path, which it tries first (OVMF's -kernel/-initrd path and
# systemd-boot use it), and from initrd= in the load options, which it
# reads straight off the ESP when nothing answers LoadFile2. An initrd
# loaded either way is unpacked AFTER the initramfs built into the
# kernel, over it: a /init in it replaces preinit. The command line is
# the built-in one with the load options appended (CMDLINE_OVERRIDE
# stays off, or a recovery entry could not say root= and lp.mode=), and
# where a word appears twice the later one wins - for the kernel's
# root= and for preinit's. The handover protocol is the older entry
# point some loaders (GRUB's linuxefi) still jump to; it costs nothing
# and keeps a GRUB chainload possible.
CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y
CONFIG_EFIVAR_FS=y
CONFIG_CMDLINE_OVERRIDE=n

# ── other people's disks ──
# USB sticks and SD cards come formatted FAT32 or exFAT; a disk from a
# Windows machine is NTFS, and ntfs3 writes to it as well as reading
# (the Windows side must be shut down fully - "fast startup" leaves the
# volume dirty and ntfs3 then mounts it read-only). Btrfs is for a disk
# from another Linux. All built in: there are no modules to load them
# from (see the top of this section), and a filesystem that is not
# there is a USB stick that "does not work".
#
# FAT file names: FAT_DEFAULT_UTF8 makes a vfat mount give UTF-8 names
# with no mount option, so a Korean file name on a stick is a Korean
# file name here. The code pages are the ones FAT needs to read short
# names (437) and the default iocharset (iso8859-1).
CONFIG_FAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=n
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# Btrfs selects the RAID6 library, which by default times its
# algorithms at boot with preemption off - 16 jiffies for each of the
# three AVX2 variants and 16 more for the xor pass, about 70ms of every
# boot spent choosing between variants for a RAID6 array this laptop
# will never have. Off, it takes the first one the CPU supports (the
# list is in order of preference) without timing anything.
CONFIG_RAID6_PQ_BENCHMARK=n

# Encrypted disks (LUKS2). cryptsetup does the key derivation (argon2)
# in userspace and hands dm-crypt the key; the kernel's part is the
# device mapper, dm-crypt, and the cipher: aes-xts-plain64, the LUKS2
# default, with AES-NI. The user-space crypto sockets are what
# cryptsetup uses to open the keyslot area without a temporary device
# mapping, and what `cryptsetup benchmark` measures. MD is only the
# menu the device mapper lives in (the Pi config switched the whole
# menu off); software RAID stays off.
CONFIG_MD=y
CONFIG_BLK_DEV_MD=n
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_SHA256_SSSE3=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# ── the same kernel under QEMU ──
# One kernel for the laptop and for the virtual machine it is tested in,
# so that what was tested is what ships. virtio-multitouch-pci is a
# virtio-input device with real ABS_MT axes, which is how touch is
# exercised without the panel.
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y

# ── performance ──
# The desktop animates on springs at 60 frames a second: 16.7ms per
# frame, in which the compositor and the client each have to be woken,
# run and finish. A frame is late - and the motion visibly hitches -
# when either one is ready but waiting for the CPU, and on a laptop
# that is building something or unpacking a package in the background
# that wait is the whole difference between smooth and not.
#
# Full preemption: how soon a woken task runs is then bounded by the
# scheduler rather than by the longest kernel path the CPU happens to
# be in. PREEMPT_DYNAMIC with PREEMPT as the build choice boots in
# "full" mode (dmesg: "Dynamic Preempt: full") and keeps
# preempt=voluntary one boot option away if a workload ever prefers
# throughput.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y

# HZ=1000. With NO_HZ_IDLE an idle CPU takes no ticks at all, so HZ costs
# nothing when the laptop is doing nothing - an idle desktop whose
# animations have all come to rest wakes no CPU for them; on a busy CPU
# it is the granularity of time slices, jiffy timeouts and timer-driven
# wakeups, and 1ms rather than 4ms is audible in audio and visible in
# input and in frame pacing. The tick itself is well under 1% of a
# Skylake core. None of this touches the power side: intel_pstate still
# runs the cores with HWP and the energy preference lp-tune sets.
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y

# Block schedulers: NVMe runs with none (its queues are the scheduler);
# mq-deadline is the default for single-queue devices; BFQ is there for
# the SD card and USB sticks, where one big copy otherwise starves every
# other reader.
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y

# Compressed memory. zram is the swap device (zstd: about a third more
# per page than lzo-rle, at a speed a Skylake core does not notice).
# zswap is built but off by default - in front of zram it would compress
# every page twice; it is for a machine that swaps to a file instead.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZORLE=n
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=n
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_CRYPTO_ZSTD=y

# Transparent huge pages only where a program asks (madvise): the win
# for browsers and JITs without the latency spikes of always-on
# compaction.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# schedutil is the default governor wherever the kernel's governors are
# used - acpi-cpufreq, intel_pstate in passive mode, virtual machines.
# On the XPS intel_pstate runs in active mode with HWP, where the CPU
# picks its own frequency and the "governor" is only powersave or
# performance plus an energy preference; that is lp-tune's to set.
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=n

# Autogroup puts each session in its own scheduling group, so a make -j8
# in a terminal does not take the desktop's share - the compositor keeps
# getting its frames out while eight compilers run. It selects CGROUPS;
# the Pi config's "no cgroups" line is overridden here on purpose.
CONFIG_SCHED_AUTOGROUP=y
CONFIG_CGROUPS=y

# -O2 rather than the Pi's -Os. On a board with 512MB and a slow SD card
# every kilobyte mattered; on an i7 the size difference is a few hundred
# kilobytes of a compressed image and the speed is every system call.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=n

# Boot: the kernel image is compressed once, and the built-in initramfs
# inside it is not compressed again - gzip inside gzip made the boot
# decompress the same bytes twice.
#
# gzip rather than zstd, which decompresses several times faster (on
# the order of a tenth of a second less at every boot for an image this
# size): the kernel build runs the HOST's zstd program to compress, the
# build machine these images are made on has none, and a kernel build
# that stops at its very last step, after twenty minutes, is what that
# looked like. If zstd becomes part of the build host, swap the first
# two lines and add it to kernel/build.sh's tool checks.
CONFIG_KERNEL_GZIP=y
CONFIG_KERNEL_ZSTD=n
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=n
