drm/virtio: offer the common desktop sizes

LP-only. QEMU's EDID (and the no-EDID fallback) gives a virtual screen
the sizes of its own table: 2560x1080, 3840x2160 and 5120x2160 are there,
2560x1440 and 2560x1600 are not. A compositor applies what the connector
lists - wayfire answers a custom mode asked for at run time with "done"
and ignores it - so a 2560x1440 monitor's size could not be chosen in a
VM at all. A virtual screen shows any size (the host scales the window),
so the common ones it lacks are added as CVT reduced-blanking modes at
60 Hz, after the EDID's and the preferred one.

--- a/drivers/gpu/drm/virtio/virtgpu_display.c	2026-09-28 10:38:44.114532285 +0000
+++ b/drivers/gpu/drm/virtio/virtgpu_display.c	2026-09-28 10:38:44.130557670 +0000
@@ -157,6 +157,45 @@
 {
 }
 
+/*
+ * LP: the sizes a desktop's Settings is expected to offer. QEMU's EDID
+ * lists 2560x1080 and 5120x2160 but not 2560x1440 or 2560x1600, and a
+ * compositor can apply only what the connector lists (wayfire ignores a
+ * custom mode asked for at run time). A virtual screen shows any size,
+ * so the missing common ones are added as CVT modes.
+ */
+static int virtio_gpu_add_common_modes(struct drm_connector *connector)
+{
+	static const struct { u16 w, h; } sizes[] = {
+		{ 1280,  720 }, { 1366,  768 }, { 1600,  900 }, { 1920, 1080 },
+		{ 2560, 1440 }, { 3200, 1800 }, { 3840, 2160 },
+		{ 1280,  800 }, { 1440,  900 }, { 1680, 1050 }, { 1920, 1200 },
+		{ 2560, 1600 }, { 2880, 1800 },
+	};
+	struct drm_display_mode *m, *mode;
+	int i, count = 0;
+
+	for (i = 0; i < ARRAY_SIZE(sizes); i++) {
+		bool have = false;
+
+		list_for_each_entry(m, &connector->probed_modes, head) {
+			if (m->hdisplay == sizes[i].w && m->vdisplay == sizes[i].h) {
+				have = true;
+				break;
+			}
+		}
+		if (have)
+			continue;
+		mode = drm_cvt_mode(connector->dev, sizes[i].w, sizes[i].h, 60,
+				    true, false, false);
+		if (!mode)
+			continue;
+		drm_mode_probed_add(connector, mode);
+		count++;
+	}
+	return count;
+}
+
 static int virtio_gpu_conn_get_modes(struct drm_connector *connector)
 {
 	struct virtio_gpu_output *output =
@@ -166,7 +205,7 @@
 
 	count = drm_edid_connector_add_modes(connector);
 	if (count)
-		return count;
+		return count + virtio_gpu_add_common_modes(connector);
 
 	width  = le32_to_cpu(output->info.r.width);
 	height = le32_to_cpu(output->info.r.height);
@@ -185,7 +224,7 @@
 		count++;
 	}
 
-	return count;
+	return count + virtio_gpu_add_common_modes(connector);
 }
 
 static enum drm_mode_status virtio_gpu_conn_mode_valid(struct drm_connector *connector,
