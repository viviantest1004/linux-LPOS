#
# lp-desktop-amd64.fragment - the kernel config of the LP desktop image,
# on top of kernel/lp-zero-amd64.config.
#
# kernel/build.sh merges it after the PC config when LP_KCONFIG_EXTRA
# names it; tools/mkdisk.sh does that for the desktop image
# (LP_DESKTOP=1) only. The plain LP disk image has no udev and no module
# loader, so for it every driver stays built in, as the PC config has it.
#
# ═══════════════════════════════════════════════════════════════════
# Every other PC
#
# The PC config (kernel/lp-zero-amd64.fragment) is the XPS 15 9550,
# built in, with its firmware in the kernel's own initramfs. This is for
# the machines LP cannot know about in advance - an AMD laptop, a Wi-Fi
# card from Realtek or MediaTek, Intel's newer Wi-Fi and sound, a
# desktop with an NVIDIA or Radeon card, a disk behind Intel's RST (VMD).
#
# Those drivers are modules. A driver built in probes before the root is
# mounted, so its firmware has to be in the initramfs; for the whole of
# linux-firmware that would be hundreds of megabytes read and unpacked
# at every boot, on machines that use a few of them. As modules they are
# loaded by udev (etc/rc: udevadm trigger) for the hardware it finds,
# after the root is mounted, and their firmware comes from /lib/firmware
# on the disk - Debian's firmware packages (tools/desktop-packages.list).
# A driver for hardware that is not there is a file nobody reads.
#
# What is needed to reach the root stays built in: NVMe, AHCI, VMD,
# eMMC, USB storage. So does the XPS's own set in the PC config,
# unchanged - apart from btusb and nouveau, which become modules because
# on every other machine their firmware is on the disk, not in the
# initramfs.
#
# Every module is signed at build time with a key made for that build
# (certs/signing_key.pem in the build directory, never in the repo) and
# the kernel refuses any module without that signature: nothing that
# did not come out of this build can be loaded into this kernel.
# ═══════════════════════════════════════════════════════════════════
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_SYSTEM_TRUSTED_KEYRING=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_XZ=y
# Firmware packages may ship compressed blobs.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ── to reach the root: built in ──
# Intel RST ("RAID" mode, the default on many Intel laptops) puts the
# NVMe drive behind the VMD controller; without it the disk is not there.
CONFIG_VMD=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_BLOCK=y
CONFIG_ATA_PIIX=y

# ── graphics ──
# amdgpu: every Radeon since GCN 1 and every Ryzen APU. radeon: the older
# Radeons. xe: Intel Lunar Lake and Battlemage (and Arc), which i915 does
# not drive. The rest are the virtual GPUs of VMware, VirtualBox, Hyper-V.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_ACP=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_DRM_HYPERV=m
CONFIG_DRM_AST=m
CONFIG_DRM_MGAG200=m
CONFIG_HSA_AMD=n

# ── Wi-Fi ──
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8723DU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_RTL8XXXU=m
CONFIG_RTL_CARDS=m
CONFIG_RTL8192CE=m
CONFIG_RTL8192SE=m
CONFIG_RTL8192DE=m
CONFIG_RTL8723AE=m
CONFIG_RTL8723BE=m
CONFIG_RTL8188EE=m
CONFIG_RTL8192EE=m
CONFIG_RTL8821AE=m
CONFIG_RTL8192CU=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_MT7925U=m
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT76x2E=m
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_BRCMSMAC=m
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_PCIE=m
CONFIG_MWIFIEX_USB=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800PCI=m

# ── Bluetooth ──
# btusb as a module: Intel's and Realtek's controllers need their patch
# from /lib/firmware, which a built-in btusb asks for before the disk is
# there. The XPS's Broadcom and Qualcomm ones get theirs the same way.
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_INTEL=y

# ── wired network ──
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_E1000=m
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=m
CONFIG_ATL1C=m
CONFIG_ATL1E=m
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=m
CONFIG_8139CP=m
CONFIG_8139TOO=m
CONFIG_VMXNET3=m
CONFIG_HYPERV_NET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_IPHETH=m

# ── sound ──
# Intel since Skylake with digital microphones or SoundWire goes through
# SOF; snd-intel-dspcfg (built in with snd-hda-intel) decides per machine
# and hands the device to SOF when it needs it. AMD's ACP does the
# microphones of Ryzen laptops. The HDA codecs stay built in: the HDA
# controller asks for its codec driver while it probes, which is before
# any module can load, and falls back to the generic parser otherwise.
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_CS8409=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_CA0110=y
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=m
CONFIG_SND_HDA_SCODEC_CS35L41_SPI=m
CONFIG_SND_HDA_SCODEC_TAS2781_I2C=m
CONFIG_SPI=y
CONFIG_SPI_PXA2XX=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_ACPI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_APOLLOLAKE=m
CONFIG_SND_SOC_SOF_GEMINILAKE=m
CONFIG_SND_SOC_SOF_CANNONLAKE=m
CONFIG_SND_SOC_SOF_COFFEELAKE=m
CONFIG_SND_SOC_SOF_COMETLAKE=m
CONFIG_SND_SOC_SOF_ICELAKE=m
CONFIG_SND_SOC_SOF_JASPERLAKE=m
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_ELKHARTLAKE=m
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_INTEL=m
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=m
CONFIG_SND_SOC_INTEL_SOF_RT5682_MACH=m
CONFIG_SND_SOC_INTEL_SOF_SSP_AMP_MACH=m
CONFIG_SND_SOC_INTEL_SOF_NAU8825_MACH=m
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=m
CONFIG_SND_SOC_AMD_ACP=m
CONFIG_SND_SOC_AMD_RENOIR=m
CONFIG_SND_SOC_AMD_RENOIR_MACH=m
CONFIG_SND_SOC_AMD_ACP5x=m
CONFIG_SND_SOC_AMD_VANGOGH_MACH=m
CONFIG_SND_SOC_AMD_ACP6x=m
CONFIG_SND_SOC_AMD_YC_MACH=m
CONFIG_SND_AMD_ACP_CONFIG=m
CONFIG_SND_SOC_AMD_PS=m
CONFIG_SND_SOC_AMD_PS_MACH=m
CONFIG_SND_SOC_AMD_RPL_ACP6x=m
CONFIG_SND_SOC_DMIC=m

# ── touchpads, keyboards, controllers ──
# Every Intel PCH's GPIO controller and AMD's: an I2C touchpad's
# interrupt is a GPIO line, and without the controller it never fires.
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_CEDARFORK=y
CONFIG_PINCTRL_DENVERTON=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_EMMITSBURG=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_LAKEFIELD=y
CONFIG_PINCTRL_LEWISBURG=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_METEORPOINT=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_AMD=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_INTEL_IDMA64=y
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_RMI4_CORE=m
CONFIG_RMI4_SMB=m
CONFIG_RMI4_F03=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
CONFIG_MOUSE_ELAN_I2C=m
CONFIG_MOUSE_ELAN_I2C_SMBUS=y
CONFIG_INTEL_ISH_HID=m
CONFIG_AMD_SFH_HID=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_APPLE=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_LENOVO=m
CONFIG_HID_ASUS=m
CONFIG_HID_ELAN=m
CONFIG_HID_ALPS=m
CONFIG_HID_WACOM=m
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_STEAM=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m

# ── laptops: hotkeys, backlight, battery charge, fans ──
CONFIG_THINKPAD_ACPI=m
CONFIG_IDEAPAD_LAPTOP=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=m
CONFIG_ACER_WMI=m
CONFIG_MSI_WMI=m
CONFIG_MSI_LAPTOP=m
CONFIG_LG_LAPTOP=m
CONFIG_HUAWEI_WMI=m
CONFIG_SAMSUNG_LAPTOP=m
CONFIG_PANASONIC_LAPTOP=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
CONFIG_INTEL_PCH_THERMAL=m
CONFIG_INT340X_THERMAL=m
# s2idle on Ryzen laptops (the only sleep most of them have) needs the
# PMC driver to reach the deepest state; amd-pstate is how the CPU picks
# its own frequency, as intel_pstate does on Intel.
CONFIG_AMD_PMC=m
CONFIG_X86_AMD_PSTATE=y
CONFIG_SENSORS_K10TEMP=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m

# ── card readers ──
CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC_REALTEK_PCI=m
CONFIG_MISC_RTSX_USB=m
CONFIG_MMC_REALTEK_USB=m
CONFIG_MISC_ALCOR_PCI=m
CONFIG_MMC_ALCOR=m
